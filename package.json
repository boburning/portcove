{
  "name": "portcove-repository",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp run frontend:static",
    "build": "node apps/desktop/scripts/build-frontend.mts",
    "test": "vp run frontend:unit",
    "test:coverage:node": "node scripts/test-coverage.mts node",
    "test:coverage:unit": "node scripts/test-coverage.mts frontend-unit",
    "test:coverage:browser": "node scripts/test-coverage.mts frontend-browser",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp run frontend:static",
    "lint:style": "vp -C apps/desktop run lint:style",
    "transport:check": "vp -C apps/desktop run transport:check",
    "precommit:check": "vp staged",
    "hooks:install": "node scripts/hooks-install.mts",
    "prepare": "node scripts/hooks-install.mts",
    "hooks:enable": "node scripts/hooks-install.mts enable",
    "hooks:disable": "node scripts/hooks-install.mts disable",
    "hooks:status": "node scripts/hooks-install.mts status",
    "check:content": "vp run frontend:content",
    "test:browser": "vp run frontend:browser",
    "test:native-tools": "vp run native:tools",
    "verify:frontend": "vp run frontend:verify"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@sigstore/bundle": "5.0.0",
    "@sigstore/sign": "5.0.0",
    "@types/node": "26.6.6",
    "@types/selenium-webdriver": "4.35.7",
    "@types/semver": "7.8.0",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "es-module-lexer": "3.0.4",
    "fallow": "3.38.1",
    "playwright": "1.64.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.16.1"
}
