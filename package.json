{
  "name": "portcove-repository",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "node apps/desktop/scripts/browser-package-compatibility.mjs && vp check && vp -C apps/desktop run lint:style",
    "build": "node apps/desktop/scripts/build-frontend.mjs",
    "test": "vp test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint && vp -C apps/desktop run lint:style",
    "lint:oxlint": "vp lint",
    "lint:style": "vp -C apps/desktop run lint:style",
    "transport:check": "vp -C apps/desktop run transport:check",
    "precommit:check": "vp staged",
    "hooks:install": "node scripts/hooks-install.mjs",
    "prepare": "node scripts/hooks-install.mjs",
    "hooks:enable": "node scripts/hooks-install.mjs enable",
    "hooks:disable": "node scripts/hooks-install.mjs disable",
    "hooks:status": "node scripts/hooks-install.mjs status",
    "build:cached": "node apps/desktop/scripts/build-frontend.mjs --cached"
  },
  "devDependencies": {
    "fallow": "^3.30.0",
    "vite-plus": "catalog:",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.11.2"
}
