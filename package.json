{
  "name": "portcove-repository",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "corepack pnpm --dir apps/desktop build",
    "format": "corepack pnpm --dir apps/desktop format",
    "format:check": "corepack pnpm --dir apps/desktop format:check",
    "lint": "corepack pnpm --dir apps/desktop lint",
    "lint:oxlint": "corepack pnpm --dir apps/desktop lint:oxlint",
    "lint:style": "corepack pnpm --dir apps/desktop lint:style",
    "test": "corepack pnpm --dir apps/desktop test",
    "transport:check": "corepack pnpm --dir apps/desktop transport:check",
    "precommit:check": "node scripts/precommit-check.mjs",
    "hooks:install": "node scripts/hooks-install.mjs"
  },
  "devDependencies": {
    "@taplo/cli": "0.7.0",
    "fallow": "^3.30.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.11.2"
}
