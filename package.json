{
  "name": "portcove-repository",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --dir apps/desktop build",
    "format": "pnpm --dir apps/desktop format",
    "format:check": "pnpm --dir apps/desktop format:check",
    "lint": "pnpm --dir apps/desktop lint",
    "lint:oxlint": "pnpm --dir apps/desktop lint:oxlint",
