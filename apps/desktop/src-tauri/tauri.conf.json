{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portcove",
  "version": "0.1.0-alpha.2",
  "identifier": "io.github.portcove.portcove",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node scripts/build-frontend.mts",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Portcove",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "windows": {
      "minimumWebview2Version": "155.0.4283.62",
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0 (>= 2.52.6)"] }
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "Portcove",
    "homepage": "https://github.com/boburning/portcove",
    "copyright": "Copyright © 2026 Portcove contributors",
    "shortDescription": "Install, update, and play native game ports.",
    "longDescription": "Browse native game ports, add the game files they need, and manage supported installations and updates in a local library.",
    "licenseFile": "../../../LICENSE-MIT"
  }
}
