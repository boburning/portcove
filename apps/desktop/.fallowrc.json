{
  "$schema": "../../node_modules/fallow/schema.json",
  "entry": [
    "i18next.invalid.config.ts",
    "src/i18next-contract.test-d.ts",
    "src/i18next.d.ts",
    "vitest.browser.config.ts"
  ],
  "boundaries": {
