{
  "$schema": "../../node_modules/fallow/schema.json",
  "entry": ["i18next.invalid.config.ts", "src/i18next-contract.test-d.ts", "src/i18next.d.ts"],
  "framework": [
    {
      "name": "portcove-desktop-unit-tests",
      "detection": {
        "type": "fileExists",
        "pattern": "scripts/**/*.test.{ts,mts}"
      },
      "entryPoints": ["scripts/**/*.test.{ts,mts}"],
      "entryPointRole": "test"
    },
    {
      "name": "portcove-desktop-native-tests",
      "detection": {
        "type": "fileExists",
        "pattern": "scripts/desktop-test.mts"
      },
      "entryPoints": [
        "src/dev-scenarios/entry.ts",
        "test/browser-setup.mts",
        "scripts/*-test.mts",
        "scripts/*.native.test.mts"
      ],
      "entryPointRole": "test",
      "toolingDependencies": ["@tauri-apps/cli"],
      "usedExports": [
        {
          "pattern": "scripts/desktop-bootstrap-recovery-test.mts",
          "exports": ["technicalDetailHasSeparation"]
        },
        {
          "pattern": "scripts/transport-values.mts",
          "exports": ["checkTransportSchemas"]
        },
        {
          "pattern": "test/capture-target.ts",
          "exports": ["requireCompleteCaptureTarget"]
        },
        {
          "pattern": "scripts/native-linux-driver-http.mts",
          "exports": ["privateNativeDriverAgentState", "inspectPrivateNativeDriverRequest"]
        },
        {
          "pattern": "scripts/native-linux-isolated-session.mts",
          "exports": ["createNativeNamespaceStreamCapture"]
        }
      ],
      "usedClassMembers": [
        {
          "implements": "NativeAccountDriverProcess",
          "members": ["signalCode", "stdout", "stderr"]
        }
      ]
    },
    {
      "name": "portcove-fixed-controller-bundle-adapter",
      "detection": {
        "type": "fileExists",
        "pattern": "scripts/release-version-bundled-runtime.mts"
      },
      "entryPoints": ["scripts/release-version-bundled-runtime.mts"],
      "entryPointRole": "support"
    }
  ],
  "boundaries": {
    "zones": [
      {
        "name": "shared",
        "patterns": ["src/shared/**"]
      },
      {
        "name": "features",
        "patterns": ["src/features/**"]
      }
    ],
    "rules": [
      {
        "from": "shared",
        "allow": ["shared"],
        "allowTypeOnly": []
      }
    ]
  }
}
