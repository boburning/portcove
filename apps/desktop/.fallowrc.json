{
  "$schema": "../../node_modules/fallow/schema.json",
  "entry": [
    "i18next.invalid.config.ts",
    "src/i18next-contract.test-d.ts",
    "src/i18next.d.ts",
    "src/dev-scenarios/entry.ts",
    "test/browser-setup.mts",
    "scripts/*.native.test.mts"
  ],
  "framework": [
    {
      "name": "portcove-desktop-unit-tests",
      "detection": { "type": "fileExists", "pattern": "scripts/**/*.test.{ts,mts}" },
      "entryPoints": ["scripts/**/*.test.{ts,mts}"],
      "entryPointRole": "test"
    }
  ],
  "boundaries": {
    "zones": [
      {
        "name": "shared",
        "patterns": ["src/shared/**"]
      },
      {
        "name": "features",
        "patterns": ["src/features/**"]
      }
    ],
    "rules": [
      {
        "from": "shared",
        "allow": ["shared"],
        "allowTypeOnly": []
      }
    ]
  }
}
