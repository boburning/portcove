{
  "portcove://application-update-notice": {
    "$defs": {
      "ApplicationUpdateAvailable": {
        "description": "A newer signed release announced by the channel feed.",
        "properties": {
          "channel": {
            "$ref": "#/$defs/ApplicationUpdateChannel"
          },
          "date": {
            "description": "Publication date as written in the feed (RFC 3339).",
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "channel",
          "notes",
          "date"
        ],
        "type": "object"
      },
      "ApplicationUpdateChannel": {
        "description": "The application release feed a player follows. Beta is the default; Preview\nis an opt-in feed that receives builds before Beta.",
        "enum": [
          "beta",
          "preview"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "available": {
        "anyOf": [
          {
            "$ref": "#/$defs/ApplicationUpdateAvailable"
          },
          {
            "type": "null"
          }
        ]
      },
      "checking": {
        "type": "boolean"
      },
      "current_version": {
        "type": "string"
      },
      "installing": {
        "type": "boolean"
      },
      "last_checked_unix_seconds": {
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "required": [
      "current_version",
      "checking",
      "installing",
      "available",
      "last_checked_unix_seconds"
    ],
    "title": "ApplicationUpdateStatus",
    "type": "object"
  },
  "portcove://library-changed": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "null",
    "type": "null"
  },
  "portcove://operation": {
    "$defs": {
      "ActivityTargetKind": {
        "enum": [
          "port",
          "source",
          "library"
        ],
        "type": "string"
      },
      "OperationResult": {
        "enum": [
          "succeeded",
          "failed",
          "cancelled"
        ],
        "type": "string"
      },
      "OperationTarget": {
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/ActivityTargetKind"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "type": "object"
      },
      "ProgressUnit": {
        "enum": [
          "bytes",
          "items",
          "ports",
          "indeterminate"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Versioned best-effort progress envelope. Durable activity history remains\nauthoritative after reconnect or restart.",
    "oneOf": [
      {
        "properties": {
          "type": {
            "const": "started",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      {
        "description": "Best-effort, exact source discovery evidence. Registration still requires\na fresh import plan and explicit acceptance.",
        "properties": {
          "path": {
            "type": "string"
          },
          "profile_id": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "const": "source_candidate",
            "type": "string"
          }
        },
        "required": [
          "type",
          "profile_id",
          "path",
          "sha256",
          "size"
        ],
        "type": "object"
      },
      {
        "properties": {
          "completed": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "phase": {
            "type": "string"
          },
          "phase_id": {
            "description": "Stable producer identity, independent of translated display wording.",
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "type": {
            "const": "progress",
            "type": "string"
          },
          "unit": {
            "anyOf": [
              {
                "$ref": "#/$defs/ProgressUnit"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absent on older producers; clients must not infer it from phase text."
          }
        },
        "required": [
          "type",
          "phase",
          "completed",
          "total"
        ],
        "type": "object"
      },
      {
        "properties": {
          "level": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "type": {
            "const": "message",
            "type": "string"
          }
        },
        "required": [
          "type",
          "level",
          "message"
        ],
        "type": "object"
      },
      {
        "properties": {
          "result": {
            "$ref": "#/$defs/OperationResult"
          },
          "type": {
            "const": "finished",
            "type": "string"
          }
        },
        "required": [
          "type",
          "result"
        ],
        "type": "object"
      }
    ],
    "properties": {
      "operation": {
        "type": "string"
      },
      "operation_id": {
        "type": "string"
      },
      "parent_operation_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "schema_version": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "sequence": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "target": {
        "anyOf": [
          {
            "$ref": "#/$defs/OperationTarget"
          },
          {
            "type": "null"
          }
        ]
      },
      "timestamp_ms": {
        "format": "int64",
        "type": "integer"
      }
    },
    "required": [
      "schema_version",
      "operation_id",
      "parent_operation_id",
      "sequence",
      "timestamp_ms",
      "operation",
      "target"
    ],
    "title": "OperationEvent",
    "type": "object"
  }
}
