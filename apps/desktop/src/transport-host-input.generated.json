{
  "application_update_choice": {
    "$defs": {
      "ApplicationChannel": {
        "enum": [
          "preview",
          "stable"
        ],
        "type": "string"
      },
      "ApplicationUpdateMode": {
        "enum": [
          "automatic",
          "notify-only",
          "manual"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "channel": {
        "$ref": "#/$defs/ApplicationChannel"
      },
      "mode": {
        "$ref": "#/$defs/ApplicationUpdateMode"
      },
      "paused": {
        "type": "boolean"
      }
    },
    "required": [
      "channel",
      "mode",
      "paused"
    ],
    "title": "ApplicationUpdateChoice",
    "type": "object"
  },
  "application_update_download_request": {
    "$defs": {
      "ApplicationChannel": {
        "enum": [
          "preview",
          "stable"
        ],
        "type": "string"
      },
      "ApplicationUpdateCandidateSummary": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "channel": {
            "$ref": "#/$defs/ApplicationChannel"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "channel",
          "bytes"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "expected_candidate": {
        "$ref": "#/$defs/ApplicationUpdateCandidateSummary"
      },
      "expected_preference_revision": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "expected_preference_revision",
      "expected_candidate"
    ],
    "title": "ApplicationUpdateDownloadRequest",
    "type": "object"
  },
  "application_update_manual_check_request": {
    "$defs": {
      "ApplicationChannel": {
        "enum": [
          "preview",
          "stable"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "channel": {
        "anyOf": [
          {
            "$ref": "#/$defs/ApplicationChannel"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "title": "ApplicationUpdateManualCheckRequest",
    "type": "object"
  },
  "application_update_production_decision": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "enum": [
      "use-stable",
      "keep-preview"
    ],
    "title": "ApplicationUpdateProductionDecision",
    "type": "string"
  },
  "application_update_recovery_area": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "enum": [
      "schedule",
      "staging",
      "apply"
    ],
    "title": "ApplicationUpdateRecoveryArea",
    "type": "string"
  },
  "catalog_download_request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "asset_id": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "destination_parent": {
        "type": "string"
      },
      "extract_archive": {
        "type": "boolean"
      },
      "port_id": {
        "type": "string"
      },
      "release_id": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "port_id",
      "release_id",
      "asset_id",
      "destination_parent",
      "extract_archive"
    ],
    "title": "CatalogDownloadRequest",
    "type": "object"
  },
  "game_file_query_request": {
    "$defs": {
      "GameFileRouteKind": {
        "enum": [
          "managed_install",
          "external_registration",
          "managed_launch",
          "external_launch"
        ],
        "type": "string"
      },
      "GameFileRouteRequest": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "$ref": "#/$defs/ReleaseChannel"
          },
          "platform": {
            "$ref": "#/$defs/Platform"
          },
          "port_id": {
            "type": "string"
          },
          "route": {
            "$ref": "#/$defs/GameFileRouteKind"
          }
        },
        "required": [
          "port_id",
          "platform",
          "channel",
          "route"
        ],
        "type": "object"
      },
      "Platform": {
        "enum": [
          "windows-x86-64",
          "linux-x86-64",
          "macos-x86-64",
          "macos-aarch64"
        ],
        "type": "string"
      },
      "RegisteredSourceInspectionLimits": {
        "additionalProperties": false,
        "properties": {
          "max_elapsed_ms": {
            "description": "Cooperative deadline, checked between reads; does not interrupt blocked filesystem calls.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "max_file_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "max_hash_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "max_file_bytes",
          "max_hash_bytes",
          "max_elapsed_ms"
        ],
        "type": "object"
      },
      "ReleaseChannel": {
        "enum": [
          "stable",
          "beta",
          "rolling"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Explicit refresh inputs. Inspection reports are never accepted from a client.",
    "properties": {
      "limits": {
        "$ref": "#/$defs/RegisteredSourceInspectionLimits"
      },
      "maximum_age_seconds": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "routes": {
        "items": {
          "$ref": "#/$defs/GameFileRouteRequest"
        },
        "type": "array"
      }
    },
    "required": [
      "routes",
      "limits",
      "maximum_age_seconds"
    ],
    "title": "GameFileQueryRefreshRequest",
    "type": "object"
  },
  "install_input": {
    "$defs": {
      "ReleaseChannel": {
        "enum": [
          "stable",
          "beta",
          "rolling"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "bios": {
        "type": [
          "string",
          "null"
        ]
      },
      "channel": {
        "anyOf": [
          {
            "$ref": "#/$defs/ReleaseChannel"
          },
          {
            "type": "null"
          }
        ]
      },
      "portId": {
        "type": "string"
      },
      "source": {
        "type": [
          "string",
          "null"
        ]
      },
      "stage": {
        "type": "boolean"
      }
    },
    "required": [
      "portId",
      "stage"
    ],
    "title": "InstallInput",
    "type": "object"
  },
  "steam_batch_selection": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "portIds": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "steamRoot": {
        "type": "string"
      },
      "steamUserId": {
        "type": "string"
      }
    },
    "required": [
      "portIds",
      "steamRoot",
      "steamUserId"
    ],
    "title": "SteamBatchSelection",
    "type": "object"
  },
  "steam_entry_selection": {
    "$defs": {
      "SteamEntryOperation": {
        "enum": [
          "add_or_repair",
          "remove"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "operation": {
        "$ref": "#/$defs/SteamEntryOperation"
      },
      "portId": {
        "type": "string"
      },
      "steamRoot": {
        "type": "string"
      },
      "steamUserId": {
        "type": "string"
      }
    },
    "required": [
      "portId",
      "steamRoot",
      "steamUserId",
      "operation"
    ],
    "title": "SteamEntrySelection",
    "type": "object"
  }
}
