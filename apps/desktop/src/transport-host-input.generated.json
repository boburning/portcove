{
  "application_update_choice": {
    "$defs": {
      "ApplicationChannel": {
        "enum": [
          "preview",
          "stable"
        ],
        "type": "string"
      },
      "ApplicationUpdateMode": {
        "enum": [
          "automatic",
          "notify-only",
          "manual"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "channel": {
        "$ref": "#/$defs/ApplicationChannel"
      },
      "mode": {
        "$ref": "#/$defs/ApplicationUpdateMode"
      },
      "paused": {
        "type": "boolean"
      }
    },
    "required": [
      "channel",
      "mode",
      "paused"
    ],
    "title": "ApplicationUpdateChoice",
    "type": "object"
  },
  "application_update_download_request": {
    "$defs": {
      "ApplicationChannel": {
        "enum": [
          "preview",
          "stable"
        ],
        "type": "string"
      },
      "ApplicationUpdateCandidateSummary": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "channel": {
            "$ref": "#/$defs/ApplicationChannel"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "channel",
          "bytes"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "expected_candidate": {
        "$ref": "#/$defs/ApplicationUpdateCandidateSummary"
      },
      "expected_preference_revision": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "expected_preference_revision",
      "expected_candidate"
    ],
    "title": "ApplicationUpdateDownloadRequest",
    "type": "object"
  },
  "application_update_manual_check_request": {
    "$defs": {
      "ApplicationChannel": {
        "enum": [
          "preview",
          "stable"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "channel": {
        "anyOf": [
          {
            "$ref": "#/$defs/ApplicationChannel"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "title": "ApplicationUpdateManualCheckRequest",
    "type": "object"
  },
  "application_update_production_decision": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "enum": [
      "use-stable",
      "keep-preview"
    ],
    "title": "ApplicationUpdateProductionDecision",
    "type": "string"
  },
  "application_update_recovery_area": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "enum": [
      "schedule",
      "staging",
      "apply"
    ],
    "title": "ApplicationUpdateRecoveryArea",
    "type": "string"
  },
  "catalog_download_request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "asset_id": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "destination_parent": {
        "type": "string"
      },
      "extract_archive": {
        "type": "boolean"
      },
      "port_id": {
        "type": "string"
      },
      "release_id": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "port_id",
      "release_id",
      "asset_id",
      "destination_parent",
      "extract_archive"
    ],
    "title": "CatalogDownloadRequest",
    "type": "object"
  },
  "game_comparison_request": {
    "$defs": {
      "Platform": {
        "enum": [
          "windows-x86-64",
          "linux-x86-64",
          "macos-x86-64",
          "macos-aarch64"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "edition_id": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "environment_id": {
        "default": null,
        "description": "An explicit observation environment, not a claim that this machine matches it.\nOmission uses an unqualified environment and cannot inherit another device's evidence.",
        "type": [
          "string",
          "null"
        ]
      },
      "evaluated_at": {
        "default": null,
        "description": "Explicit replay clock. Adapters must not replace a supplied clock.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "platform": {
        "anyOf": [
          {
            "$ref": "#/$defs/Platform"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "port_id": {
        "description": "A current or retained listing. Only explicit original-game IDs relate alternatives.",
        "type": "string"
      },
      "refresh": {
        "default": false,
        "description": "Reuse the existing provider's conditional requests, cache and network limits.",
        "type": "boolean"
      },
      "required_capabilities": {
        "default": [],
        "items": {
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "source_profile_ids": {
        "default": null,
        "description": "Catalog profile IDs only. Omission uses this library's explicit registrations;\npresence describes a hypothetical source context, not a fresh file verification.",
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ],
        "uniqueItems": true
      }
    },
    "required": [
      "port_id"
    ],
    "title": "GameComparisonRequest",
    "type": "object"
  },
  "game_file_query_request": {
    "$defs": {
      "GameFileRouteKind": {
        "enum": [
          "managed_install",
          "external_registration",
          "managed_launch",
          "external_launch"
        ],
        "type": "string"
      },
      "GameFileRouteRequest": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "$ref": "#/$defs/ReleaseChannel"
          },
          "platform": {
            "$ref": "#/$defs/Platform"
          },
          "port_id": {
            "type": "string"
          },
          "route": {
            "$ref": "#/$defs/GameFileRouteKind"
          }
        },
        "required": [
          "port_id",
          "platform",
          "channel",
          "route"
        ],
        "type": "object"
      },
      "Platform": {
        "enum": [
          "windows-x86-64",
          "linux-x86-64",
          "macos-x86-64",
          "macos-aarch64"
        ],
        "type": "string"
      },
      "RegisteredSourceInspectionLimits": {
        "additionalProperties": false,
        "properties": {
          "max_elapsed_ms": {
            "description": "Cooperative deadline, checked between reads; does not interrupt blocked filesystem calls.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "max_file_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "max_hash_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "max_file_bytes",
          "max_hash_bytes",
          "max_elapsed_ms"
        ],
        "type": "object"
      },
      "ReleaseChannel": {
        "enum": [
          "stable",
          "beta",
          "rolling"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Explicit refresh inputs. Inspection reports are never accepted from a client.",
    "properties": {
      "limits": {
        "$ref": "#/$defs/RegisteredSourceInspectionLimits"
      },
      "maximum_age_seconds": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "routes": {
        "items": {
          "$ref": "#/$defs/GameFileRouteRequest"
        },
        "type": "array"
      }
    },
    "required": [
      "routes",
      "limits",
      "maximum_age_seconds"
    ],
    "title": "GameFileQueryRefreshRequest",
    "type": "object"
  },
  "install_input": {
    "$defs": {
      "ReleaseChannel": {
        "enum": [
          "stable",
          "beta",
          "rolling"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "bios": {
        "type": [
          "string",
          "null"
        ]
      },
      "channel": {
        "anyOf": [
          {
            "$ref": "#/$defs/ReleaseChannel"
          },
          {
            "type": "null"
          }
        ]
      },
      "portId": {
        "type": "string"
      },
      "source": {
        "type": [
          "string",
          "null"
        ]
      },
      "stage": {
        "type": "boolean"
      }
    },
    "required": [
      "portId",
      "stage"
    ],
    "title": "InstallInput",
    "type": "object"
  },
  "organization_change": {
    "$defs": {
      "InstallationContext": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "installation_id": {
                "type": "string"
              },
              "kind": {
                "const": "managed",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "installation_id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "installation_id": {
                "type": "string"
              },
              "kind": {
                "const": "external",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "installation_id"
            ],
            "type": "object"
          }
        ]
      },
      "SetupConfirmation": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/$defs/InstallationContext"
          },
          "port_id": {
            "type": "string"
          }
        },
        "required": [
          "port_id",
          "context"
        ],
        "type": "object"
      },
      "UpdateNoticeChoice": {
        "additionalProperties": true,
        "properties": {
          "paused": {
            "type": "boolean"
          },
          "skipped_release": {
            "anyOf": [
              {
                "$ref": "#/$defs/UpdateNoticeRelease"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "paused"
        ],
        "type": "object"
      },
      "UpdateNoticeRelease": {
        "additionalProperties": false,
        "properties": {
          "artifact_sha256": {
            "description": "Same-tag rebuilds with different bytes must remain visible.",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "artifact_sha256"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "game_id": {
            "type": "string"
          },
          "kind": {
            "const": "set_preferred_implementation",
            "type": "string"
          },
          "port_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "game_id"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "followed": {
            "type": "boolean"
          },
          "kind": {
            "const": "set_followed_project",
            "type": "string"
          },
          "observed_identity": {
            "description": "Optionally acknowledge the exact release already visible when following.",
            "type": [
              "string",
              "null"
            ]
          },
          "port_id": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "port_id",
          "followed"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "identity": {
            "type": "string"
          },
          "kind": {
            "const": "acknowledge_followed_release",
            "type": "string"
          },
          "port_id": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "port_id",
          "identity"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "hidden": {
            "type": "boolean"
          },
          "kind": {
            "const": "set_hidden",
            "type": "string"
          },
          "port_id": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "port_id",
          "hidden"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "game_id": {
            "type": "string"
          },
          "kind": {
            "const": "set_saved",
            "type": "string"
          },
          "saved": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "game_id",
          "saved"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "game_id": {
            "type": "string"
          },
          "kind": {
            "const": "set_saved_group",
            "type": "string"
          },
          "legacy_port_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "saved": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "game_id",
          "legacy_port_ids",
          "saved"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "collection_id": {
            "type": "string"
          },
          "kind": {
            "const": "upsert_collection",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "collection_id",
          "name"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "collection_id": {
            "type": "string"
          },
          "kind": {
            "const": "remove_collection",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "collection_id"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "collection_id": {
            "type": "string"
          },
          "included": {
            "type": "boolean"
          },
          "kind": {
            "const": "set_collection_port",
            "type": "string"
          },
          "port_id": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "collection_id",
          "port_id",
          "included"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "choice": {
            "$ref": "#/$defs/UpdateNoticeChoice"
          },
          "kind": {
            "const": "set_update_notice",
            "type": "string"
          },
          "port_id": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "port_id",
          "choice"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "confirmation": {
            "$ref": "#/$defs/SetupConfirmation"
          },
          "confirmed": {
            "type": "boolean"
          },
          "kind": {
            "const": "set_setup_confirmation",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "confirmation",
          "confirmed"
        ],
        "type": "object"
      }
    ],
    "title": "OrganizationChange"
  },
  "steam_batch_selection": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "portIds": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "steamRoot": {
        "type": "string"
      },
      "steamUserId": {
        "type": "string"
      }
    },
    "required": [
      "portIds",
      "steamRoot",
      "steamUserId"
    ],
    "title": "SteamBatchSelection",
    "type": "object"
  },
  "steam_entry_selection": {
    "$defs": {
      "SteamEntryOperation": {
        "enum": [
          "add_or_repair",
          "remove"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "operation": {
        "$ref": "#/$defs/SteamEntryOperation"
      },
      "portId": {
        "type": "string"
      },
      "steamRoot": {
        "type": "string"
      },
      "steamUserId": {
        "type": "string"
      }
    },
    "required": [
      "portId",
      "steamRoot",
      "steamUserId",
      "operation"
    ],
    "title": "SteamEntrySelection",
    "type": "object"
  }
}
