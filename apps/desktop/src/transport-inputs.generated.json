{
  "catalog_update_source": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "properties": {
          "kind": {
            "const": "file",
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "type": "object"
      },
      {
        "properties": {
          "kind": {
            "const": "https",
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "type": "object"
      }
    ],
    "title": "CatalogUpdateSource"
  },
  "definition_capability_request": {
    "$defs": {
      "DefinitionCapabilityRequirement": {
        "additionalProperties": false,
        "properties": {
          "maximum_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "minimum_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "template": {
            "type": "string"
          }
        },
        "required": [
          "template",
          "minimum_version",
          "maximum_version"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "capability_contract_schema": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "required_capabilities": {
        "items": {
          "$ref": "#/$defs/DefinitionCapabilityRequirement"
        },
        "type": "array"
      }
    },
    "required": [
      "capability_contract_schema",
      "required_capabilities"
    ],
    "title": "DefinitionCapabilityRequest",
    "type": "object"
  },
  "game_file_query_request": {
    "$defs": {
      "GameFileRouteKind": {
        "enum": [
          "managed_install",
          "external_registration",
          "managed_launch",
          "external_launch"
        ],
        "type": "string"
      },
      "GameFileRouteRequest": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "$ref": "#/$defs/ReleaseChannel"
          },
          "platform": {
            "$ref": "#/$defs/Platform"
          },
          "port_id": {
            "type": "string"
          },
          "route": {
            "$ref": "#/$defs/GameFileRouteKind"
          }
        },
        "required": [
          "port_id",
          "platform",
          "channel",
          "route"
        ],
        "type": "object"
      },
      "Platform": {
        "enum": [
          "windows-x86-64",
          "linux-x86-64",
          "macos-x86-64",
          "macos-aarch64"
        ],
        "type": "string"
      },
      "RegisteredSourceInspectionLimits": {
        "additionalProperties": false,
        "properties": {
          "max_elapsed_ms": {
            "description": "Cooperative deadline, checked between reads; does not interrupt blocked filesystem calls.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "max_file_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "max_hash_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "max_file_bytes",
          "max_hash_bytes",
          "max_elapsed_ms"
        ],
        "type": "object"
      },
      "ReleaseChannel": {
        "enum": [
          "stable",
          "beta",
          "rolling"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Explicit refresh inputs. Inspection reports are never accepted from a client.",
    "properties": {
      "limits": {
        "$ref": "#/$defs/RegisteredSourceInspectionLimits"
      },
      "maximum_age_seconds": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "routes": {
        "items": {
          "$ref": "#/$defs/GameFileRouteRequest"
        },
        "type": "array"
      }
    },
    "required": [
      "routes",
      "limits",
      "maximum_age_seconds"
    ],
    "title": "GameFileQueryRefreshRequest",
    "type": "object"
  },
  "game_setting_change": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "set",
            "type": "string"
          },
          "value": true
        },
        "required": [
          "action",
          "value"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "reset",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      }
    ],
    "title": "GameSettingChange"
  },
  "source_discovery_limits": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "max_candidates": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "max_depth": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "max_entries": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "max_file_bytes": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "max_hash_bytes": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "max_entries",
      "max_depth",
      "max_file_bytes",
      "max_hash_bytes",
      "max_candidates"
    ],
    "title": "SourceDiscoveryLimits",
    "type": "object"
  },
  "source_discovery_request": {
    "$defs": {
      "SourceDiscoveryLimits": {
        "properties": {
          "max_candidates": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "max_depth": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "max_entries": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "max_file_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "max_hash_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "max_entries",
          "max_depth",
          "max_file_bytes",
          "max_hash_bytes",
          "max_candidates"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "limits": {
        "$ref": "#/$defs/SourceDiscoveryLimits",
        "default": {
          "max_candidates": 64,
          "max_depth": 6,
          "max_entries": 10000,
          "max_file_bytes": 2147483648,
          "max_hash_bytes": 17179869184
        }
      },
      "profile_ids": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "roots": {
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "roots",
      "profile_ids"
    ],
    "title": "SourceDiscoveryRequest",
    "type": "object"
  }
}
