{
  "name": "portcove-desktop-ui",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "pnpm run format:oxfmt && pnpm run format:toml",
    "format:check": "pnpm run format:oxfmt:check && pnpm run format:toml:check",
    "format:oxfmt": "node ../../scripts/run-oxfmt.mjs --write",
    "format:oxfmt:check": "node ../../scripts/run-oxfmt.mjs --check",
    "format:toml": "taplo format --config ../../taplo.toml ../../taplo.toml && node scripts/format-toml.mjs",
    "format:toml:check": "taplo format --check --config ../../taplo.toml ../../taplo.toml && node scripts/format-toml.mjs --check",
    "release:policy": "node scripts/release-version-policy.mjs",
    "test:release-policy": "vitest run scripts/release-version-policy.test.mjs scripts/prepare-release-version.test.mjs",
    "test:install-fixture": "vitest run scripts/desktop-install-fixture.test.mjs",
    "test:adapter-conformance": "vitest run scripts/adapter-conformance.test.mjs && node scripts/adapter-conformance.mjs",
    "release:prepare": "node scripts/prepare-release-version.mjs",
    "test:desktop": "node scripts/desktop-test.mjs",
    "browser:bootstrap": "node scripts/browser-runtime.mjs bootstrap",
    "test:browser": "node scripts/browser-runtime.mjs test",
    "test:browser:trace-probe": "node scripts/browser-runtime.mjs probe",
    "test:native-compatibility:embedded": "node test/native-compatibility.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "typecheck": "tsc && pnpm typecheck:orchestration",
    "typecheck:orchestration": "tsc --project tsconfig.orchestration.json",
    "build": "pnpm typecheck && vite build",
    "lint:oxlint": "node ../../scripts/run-oxlint.mjs",
    "lint:style": "stylelint --config stylelint.config.mjs --max-warnings 0 \"src/**/*.css\"",
    "lint": "pnpm lint:oxlint && pnpm lint:style",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "preview": "vite preview",
    "test": "vitest run --pool=threads --isolate --maxWorkers=2 --testTimeout=5000 --reporter=default --reporter=json --outputFile=../../work/ui-tests.json && node ../../scripts/check-vitest-durations.mjs ../../work/ui-tests.json && node scripts/check-theme.mjs && node scripts/check-copy.mjs && pnpm i18n:check",
    "test:copy": "vitest run scripts/check-copy.test.mjs src/count-messages.test.ts && node scripts/check-copy.mjs",
    "test:theme": "node scripts/check-theme.mjs",
    "i18n:extract": "i18next-cli extract",
    "i18n:check": "i18next-cli extract --ci && i18next-cli status && i18next-cli lint && i18next-cli types --ci && node scripts/check-i18n-negative-fixture.mjs",
    "transport:check": "node scripts/generate-transport-types.mjs",
    "test:cli-handoff": "vitest run scripts/cli-command-shell.test.mjs src/cli-command.test.ts src/components/CliContinuity.test.tsx"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.2",
    "i18next": "26.4.2",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "17.0.15",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "axe-core": "4.13.0",
    "i18next-cli": "1.74.1",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "16.0.0",
    "oxc-parser": "0.151.0",
    "playwright": "1.63.0",
    "selenium-webdriver": "4.49.0",
    "semver": "7.8.5",
    "stylelint": "17.15.0",
    "stylelint-config-recommended": "18.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
