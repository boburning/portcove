{
  "name": "portcove-desktop-ui",
  "private": true,
  "version": "0.1.0-alpha.2",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "release:policy": "node scripts/release-version-policy.mjs",
    "test:release-policy": "vitest run scripts/release-version-policy.test.mjs scripts/prepare-release-version.test.mjs",
    "release:prepare": "node scripts/prepare-release-version.mjs",
    "test:desktop": "node scripts/desktop-test.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "preview": "vite preview",
    "test": "vitest run --pool=threads --isolate --maxWorkers=2 --testTimeout=5000 --reporter=default --reporter=json --outputFile=../../work/ui-tests.json && node ../../scripts/check-vitest-durations.mjs ../../work/ui-tests.json && node scripts/check-theme.mjs",
    "test:theme": "node scripts/check-theme.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "4.11.1",
    "fallow": "^3.22.0",
    "jsdom": "^30.0.1",
    "selenium-webdriver": "4.48.0",
    "semver": "7.8.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
