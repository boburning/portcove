{
  "name": "portcove-desktop-ui",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "vp fmt && vp run format:toml",
    "format:check": "vp fmt --check && vp run format:toml:check",
    "format:toml": "taplo format --config ../../taplo.toml ../../taplo.toml && node scripts/format-toml.mjs",
    "format:toml:check": "taplo format --check --config ../../taplo.toml ../../taplo.toml && node scripts/format-toml.mjs --check",
    "release:policy": "node scripts/release-version-policy.mjs",
    "test:release-policy": "vp test scripts/release-version-policy.test.mjs scripts/prepare-release-version.test.mjs",
    "test:build-environment": "vp test scripts/build-frontend.test.mjs",
    "test:webview-boundary": "node scripts/desktop-webview-boundary.mjs",
    "test:install-fixture": "vp test scripts/desktop-install-fixture.test.mjs",
    "test:adapter-conformance": "vp test scripts/adapter-conformance.test.mjs && node scripts/adapter-conformance.mjs",
    "release:prepare": "node scripts/prepare-release-version.mjs",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:appimage-update": "node scripts/desktop-appimage-update-test.mjs",
    "test:macos-installed-update": "node scripts/desktop-macos-installed-update-test.mjs",
    "test:windows-embedded-preflight": "node scripts/desktop-windows-embedded-preflight.mjs",
    "test:windows-update": "node scripts/desktop-windows-update-test.mjs",
    "browser:bootstrap": "node scripts/browser-runtime.mjs bootstrap",
    "test:browser": "vp test --project browser",
    "test:native-compatibility:embedded": "node test/native-compatibility.mjs",
    "dev": "vp dev",
    "typecheck": "vp check --no-fmt --no-lint",
    "build": "node scripts/build-frontend.mjs",
    "lint:oxlint": "vp lint",
    "lint:style": "stylelint --config stylelint.config.mjs --max-warnings 0 \"src/**/*.css\"",
    "lint": "vp lint && vp run lint:style",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "preview": "vp preview",
    "test": "vp test",
    "test:copy": "vp test scripts/check-copy.test.mjs src/count-messages.test.ts && node scripts/check-copy.mjs",
    "test:theme": "node scripts/check-theme.mjs",
    "i18n:extract": "i18next-cli extract",
    "i18n:check": "i18next-cli extract --ci && i18next-cli status && i18next-cli lint && i18next-cli types --ci && node scripts/check-i18n-negative-fixture.mjs",
    "transport:check": "node scripts/generate-transport-types.mjs",
    "test:cli-handoff": "vp test scripts/cli-command-shell.test.mjs src/cli-command.test.ts src/components/CliContinuity.test.tsx",
    "test:after-copy": "vp test --project unit",
    "check": "vp check",
    "check:content": "node scripts/check-copy.mjs && node scripts/check-theme.mjs && vp run i18n:check",
    "test:browser:trace-probe": "node scripts/browser-runtime.mjs probe",
    "build:cached": "node scripts/build-frontend.mjs --cached"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "i18next": "26.4.3",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "17.0.16",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "4.13.0",
    "i18next-cli": "1.74.2",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "16.0.0",
    "oxc-parser": "0.151.0",
    "playwright": "1.63.0",
    "selenium-webdriver": "4.49.0",
    "semver": "7.8.5",
    "stylelint": "17.15.0",
    "stylelint-config-recommended": "18.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
