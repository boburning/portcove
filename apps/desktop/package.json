{
  "name": "portcove-desktop-ui",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "vp -C ../.. fmt",
    "format:check": "vp -C ../.. fmt --check",
    "release:policy": "node scripts/release-version-policy.mts",
    "test:release-policy": "node ../../scripts/run-ui-tests.mts exact scripts/release-version-policy.test.mts scripts/prepare-release-version.test.mts",
    "test:build-environment": "node ../../scripts/run-ui-tests.mts exact scripts/build-frontend.test.mts",
    "test:webview-boundary": "node scripts/desktop-webview-boundary.mts",
    "test:install-fixture": "node ../../scripts/run-ui-tests.mts exact scripts/desktop-install-fixture.test.mts && vp -C ../.. run native:tools",
    "test:adapter-conformance": "node ../../scripts/run-ui-tests.mts exact scripts/adapter-conformance.test.mts && node scripts/adapter-conformance.mts",
    "release:prepare": "node scripts/prepare-release-version.mts",
    "test:desktop": "node scripts/desktop-test.mts",
    "test:appimage-update": "node scripts/desktop-appimage-update-test.mts",
    "test:macos-installed-update": "node scripts/desktop-macos-installed-update-test.mts",
    "test:windows-embedded-preflight": "node scripts/desktop-windows-embedded-preflight.mts",
    "test:windows-update": "node scripts/desktop-windows-update-test.mts",
    "browser:bootstrap": "node scripts/browser-runtime.mts bootstrap",
    "test:browser": "vp -C ../.. run frontend:browser",
    "test:native-compatibility:embedded": "node test/native-compatibility.mts",
    "dev": "vp dev",
    "typecheck": "pnpm --dir ../.. exec node scripts/run-viteplus.mts check --no-fmt --no-lint",
    "build": "node scripts/build-frontend.mts",
    "lint:style": "stylelint --config stylelint.config.mjs --max-warnings 0 \"src/**/*.css\"",
    "lint": "vp -C ../.. run frontend:static",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "node ../../scripts/native-build.mts",
    "preview": "vp preview",
    "test": "vp -C ../.. run frontend:unit",
    "test:copy": "node ../../scripts/run-ui-tests.mts exact scripts/check-copy.test.mts src/count-messages.test.ts",
    "test:theme": "node ../../scripts/run-ui-tests.mts exact scripts/check-theme.test.ts",
    "i18n:extract": "i18next-cli extract",
    "i18n:check": "i18next-cli extract --ci && i18next-cli status && i18next-cli lint && i18next-cli types --ci && node scripts/check-i18n-negative-fixture.mts",
    "transport:check": "node scripts/generate-transport-types.mts",
    "test:cli-handoff": "node ../../scripts/run-ui-tests.mts exact src/cli-command.test.ts src/components/CliContinuity.browser.test.tsx && vp -C ../.. run native:tools",
    "check": "vp -C ../.. run frontend:static",
    "check:content": "vp -C ../.. run frontend:content",
    "test:browser:trace-probe": "node scripts/browser-runtime.mts probe",
    "verify:frontend": "vp -C ../.. run frontend:verify"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "i18next": "26.5.12",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "17.1.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "i18next-cli": "1.80.6",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.64.1",
    "selenium-webdriver": "4.52.0",
    "semver": "7.8.5",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "tailwindcss": "4.3.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.3.0",
    "yaml": "2.9.1"
  }
}
