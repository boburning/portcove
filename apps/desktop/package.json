{
  "name": "portcove-desktop-ui",
  "private": true,
  "version": "0.1.0-alpha.2",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "format": "pnpm run format:prettier && pnpm run format:toml",
    "format:check": "pnpm run format:prettier:check && pnpm run format:toml:check",
    "format:prettier": "cd ../.. && prettier --write --ignore-path .prettierignore .",
    "format:prettier:check": "cd ../.. && prettier --check --ignore-path .prettierignore .",
    "format:toml": "cd ../.. && node scripts/format-toml.mjs",
    "format:toml:check": "cd ../.. && node scripts/format-toml.mjs --check",
    "release:policy": "node scripts/release-version-policy.mjs",
    "test:release-policy": "vitest run scripts/release-version-policy.test.mjs scripts/prepare-release-version.test.mjs",
    "release:prepare": "node scripts/prepare-release-version.mjs",
    "test:desktop": "node scripts/desktop-test.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "preview": "vite preview",
    "test": "vitest run --pool=threads --isolate --maxWorkers=2 --testTimeout=5000 --reporter=default --reporter=json --outputFile=../../work/ui-tests.json && node ../../scripts/check-vitest-durations.mjs ../../work/ui-tests.json && node scripts/check-theme.mjs && node scripts/check-copy.mjs",
    "test:copy": "vitest run scripts/check-copy.test.mjs src/count-messages.test.ts && node scripts/check-copy.mjs",
    "test:theme": "node scripts/check-theme.mjs",
    "transport:check": "node scripts/generate-transport-types.mjs",
    "test:cli-handoff": "vitest run scripts/cli-command-shell.test.mjs src/cli-command.test.ts src/components/CliContinuity.test.tsx"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@taplo/cli": "0.7.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "4.13.0",
    "fallow": "^3.22.0",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.6",
    "selenium-webdriver": "4.48.0",
    "semver": "7.8.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
