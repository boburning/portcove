{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "enabledManagers": ["cargo", "npm", "github-actions", "rust-toolchain", "custom.regex"],
  "labels": ["dependencies"],
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "commitHourlyLimit": 4,
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Keep immutable GitHub Action references and group their reviewed updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "schedule": ["* * * * 1,4"],
      "pinDigests": true
    },
    {
      "description": "Propose npm development-tool maintenance on the weekly tooling cadence",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "schedule": ["* * * * 1,4"]
    },
    {
      "description": "Propose repository-managed development tools on the weekly tooling cadence",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "just",
        "cargo-shear",
        "cargo-deny",
        "cargo-modules",
        "rscheck-cli",
        "cargo-mutants",
        "cargo-nextest",
        "rust",
        "node",
        "tauri-driver",
        "aquaproj/aqua",
        "astral-sh/ruff",
        "rhysd/actionlint",
        "koalaman/shellcheck",
        "PSScriptAnalyzer",
        "anchore/syft"
      ],
      "schedule": ["* * * * 1,4"]
    },
    {
      "description": "Update the React runtime and declarations together",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react",
      "schedule": ["at any time"]
    },
    {
      "description": "Keep Tauri JavaScript and Rust packages in one qualification unit",
      "matchPackageNames": ["/^@tauri-apps\\//", "/^tauri(?:-|$)/"],
      "groupName": "tauri",
      "schedule": ["at any time"]
    },
    {
      "description": "Qualify Vite and its React integration together",
      "matchPackageNames": ["vite", "@vitejs/plugin-react"],
      "groupName": "vite",
      "schedule": ["* * * * 1,4"]
    },
    {
      "description": "Keep Vitest and installed browser providers in one compatibility unit",
      "matchPackageNames": ["vitest", "/^@vitest\\//"],
      "groupName": "vitest",
      "schedule": ["* * * * 1,4"]
    },
    {
      "description": "Qualify Oxc parsing formatting and linting together",
      "matchPackageNames": ["oxc-parser", "oxfmt", "oxlint", "oxlint-tsgolint"],
      "groupName": "oxc-toolchain",
      "schedule": ["* * * * 1,4"]
    },
    {
      "description": "Qualify Tailwind and its Vite integration together",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/vite"],
      "groupName": "tailwind",
      "schedule": ["* * * * 1,4"]
    },
    {
      "description": "Qualify Stylelint and its shared configuration together",
      "matchPackageNames": ["stylelint", "stylelint-config-recommended"],
      "groupName": "stylelint",
      "schedule": ["* * * * 1,4"]
    },
    {
      "description": "Keep the Rust compiler authorities in one reviewed change",
      "matchPackageNames": ["rust"],
      "groupName": "rust-toolchain",
      "schedule": ["* * * * 1,4"]
    },
    {
      "description": "Keep Aqua and its managed quality tools in one qualification unit",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "aquaproj/aqua",
        "astral-sh/ruff",
        "rhysd/actionlint",
        "koalaman/shellcheck"
      ],
      "groupName": "aqua-toolchain",
      "schedule": ["* * * * 1,4"]
    },
    {
      "description": "Change the Aqua registry authority only with a reviewed tool or integrity need",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-tags"],
      "matchDepNames": ["aquaproj/aqua-registry"],
      "matchPackageNames": ["aquaproj/aqua-registry"],
      "enabled": false
    },
    {
      "description": "Do not replace the reviewed SQLite upstream revision automatically",
      "matchManagers": ["cargo"],
      "matchDatasources": ["git-refs"],
      "matchDepNames": ["rusqlite"],
      "matchPackageNames": ["https://github.com/rusqlite/rusqlite"],
      "enabled": false
    },
    {
      "description": "Select major migrations before they consume ordinary queue slots",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "prPriority": -10
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/quality-tools\\.json$/"],
      "matchStrings": [
        "\\\"crate\\\":\\s*\\\"(?<depName>[^\\\"]+)\\\",\\s*\\\"version\\\":\\s*\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "datasourceTemplate": "crate",
      "versioningTemplate": "cargo"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/quality-tools\\.json$/"],
      "matchStrings": ["\\\"channel\\\":\\s*\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust-version",
      "versioningTemplate": "rust"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.node-version$/"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.config\\/tool-bootstrap\\.json$/"],
      "matchStrings": ["\\\"tauri_driver\\\":\\s*\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""],
      "depNameTemplate": "tauri-driver",
      "datasourceTemplate": "crate",
      "versioningTemplate": "cargo"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.aqua-version$/"],
      "matchStrings": ["(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "aquaproj/aqua",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^aqua\\.yaml$/"],
      "matchStrings": ["ref:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "aquaproj/aqua-registry",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^aqua\\.yaml$/"],
      "matchStrings": ["- name:\\s*(?<depName>[^@\\s]+)@(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.config\\/powershell-resources\\.psd1$/"],
      "matchStrings": [
        "(?<depName>PSScriptAnalyzer)[\\s\\S]*?version\\s*=\\s*'(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://www.powershellgallery.com/api/v2/",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/release\\.yml$/"],
      "matchStrings": ["syft-version:\\s*v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "anchore/syft",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "timezone": "America/New_York",
  "prCreation": "immediate",
  "updateNotScheduled": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "groupName": null,
    "labels": ["dependencies", "security"]
  }
}
