{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "enabledManagers": [
    "cargo",
    "npm",
    "github-actions",
    "rust-toolchain",
    "custom.regex",
    "dockerfile"
  ],
  "labels": ["dependencies"],
  "automerge": false,
  "minimumReleaseAge": "1 day",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 4,
  "branchConcurrentLimit": 4,
  "prHourlyLimit": 0,
  "commitHourlyLimit": 0,
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Keep serde_json updates within its existing Cargo range and lock the eligible selected version",
      "matchManagers": ["cargo"],
      "matchDatasources": ["crate"],
      "matchPackageNames": ["serde_json"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Keep immutable GitHub Action references and group their reviewed updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "schedule": ["at any time"],
      "pinDigests": true
    },
    {
      "description": "Propose npm development-tool maintenance continuously",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "schedule": ["at any time"]
    },
    {
      "description": "Propose repository-managed development tools continuously",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "just",
        "cargo-shear",
        "cargo-deny",
        "cargo-modules",
        "rscheck-cli",
        "cargo-mutants",
        "cargo-nextest",
        "rust",
        "node",
        "tauri-driver",
        "aquaproj/aqua",
        "astral-sh/ruff",
        "rhysd/actionlint",
        "koalaman/shellcheck",
        "PSScriptAnalyzer",
        "anchore/syft"
      ],
      "schedule": ["at any time"]
    },
    {
      "description": "Update the React runtime and declarations together",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react",
      "schedule": ["at any time"]
    },
    {
      "description": "Keep Tauri JavaScript and Rust packages in one qualification unit",
      "matchPackageNames": ["/^@tauri-apps\\//", "/^tauri(?:-|$)/", "webview2-com"],
      "groupName": "tauri",
      "schedule": ["at any time"]
    },
    {
      "description": "Exclude CLI 2.12.3 RPM prerelease regression until requalified under #2014",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@tauri-apps/cli"],
      "allowedVersions": "!/^2\\.12\\.3$/"
    },
    {
      "description": "Qualify Tailwind and its Vite integration together",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/vite"],
      "groupName": "tailwind",
      "schedule": ["at any time"]
    },
    {
      "description": "Qualify Stylelint and its shared configuration together",
      "matchPackageNames": ["stylelint", "stylelint-config-recommended"],
      "groupName": "stylelint",
      "schedule": ["at any time"]
    },
    {
      "description": "Keep the Rust compiler authorities in one reviewed change",
      "matchPackageNames": ["rust"],
      "groupName": "rust-toolchain",
      "schedule": ["at any time"]
    },
    {
      "description": "Keep Aqua and its managed quality tools in one qualification unit",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "aquaproj/aqua",
        "astral-sh/ruff",
        "rhysd/actionlint",
        "koalaman/shellcheck"
      ],
      "groupName": "aqua-toolchain",
      "schedule": ["at any time"]
    },
    {
      "description": "Change the Aqua registry authority only with a reviewed tool or integrity need",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-tags"],
      "matchDepNames": ["aquaproj/aqua-registry"],
      "matchPackageNames": ["aquaproj/aqua-registry"],
      "enabled": false
    },
    {
      "description": "Do not replace the reviewed SQLite upstream revision automatically",
      "matchManagers": ["cargo"],
      "matchDatasources": ["git-refs"],
      "matchDepNames": ["rusqlite"],
      "matchPackageNames": ["https://github.com/rusqlite/rusqlite"],
      "enabled": false
    },
    {
      "description": "Select major migrations before they consume ordinary queue slots",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "prPriority": -10
    },
    {
      "description": "Keep bundled aliases and browser providers on the selected Vite+ release",
      "matchPackageNames": ["@voidzero-dev/vite-plus-core", "vitest", "/^@vitest\\//", "vite"],
      "enabled": false,
      "matchJsonata": ["$not($exists(isVulnerabilityAlert)) or isVulnerabilityAlert != true"]
    },
    {
      "description": "Discover Vite+ releases automatically; complete the coordinated migrator graph before delivery",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vite-plus"],
      "groupName": "vite-plus",
      "enabled": true,
      "schedule": ["at any time"],
      "prBodyNotes": [
        "This proposal selects a Vite+ target only. Before merge, use the verified pre-upgrade inputs and supported target migrator to update the complete toolchain, including catalogs, aliases, overrides and the browser provider. Follow docs/DEVELOPMENT-TOOLS.md#coordinated-upgrades-and-rollback. A primary-only bump is not merge-ready."
      ]
    },
    {
      "description": "Keep the optional browser image paired with the selected Vite+ release and immutable base identity",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["ghcr.io/voidzero-dev/vite-plus"],
      "groupName": "vite-plus",
      "pinDigests": true,
      "schedule": ["at any time"],
      "prBodyNotes": [
        "The browser image tag must match the source catalog Vite+ pin. Preserve a verified digest and run the coordinated compatibility controls plus actual Windows container qualification before delivery; a Dockerfile-only version bump is not merge-ready."
      ]
    },
    {
      "description": "Coordinate Linux PowerShell proposals with the official archive SHA256 and actual canonical package/smoke execution",
      "matchPackageNames": ["PowerShell/PowerShell"],
      "prBodyNotes": [
        "Update the paired POWERSHELL_SHA256 from the official release asset digest and requalify Ubuntu 22.04 execution. A version-only proposal must fail preparation and is not merge-ready."
      ]
    },
    {
      "description": "Retain npm update metadata after inherited confidence presentation rules",
      "matchManagers": ["npm"],
      "prBodyColumns": ["Package", "Type", "Update", "Change", "Pending", "Age", "Confidence"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/quality-tools\\.json$/"],
      "matchStrings": [
        "\\\"crate\\\":\\s*\\\"(?<depName>[^\\\"]+)\\\",\\s*\\\"version\\\":\\s*\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "datasourceTemplate": "crate",
      "versioningTemplate": "cargo"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/quality-tools\\.json$/"],
      "matchStrings": ["\\\"channel\\\":\\s*\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust-version",
      "versioningTemplate": "rust"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.node-version$/",
        "/^scripts\\/controller-node-runtime\\.mts$/",
        "/^\\.github\\/workflows\\/application-update-production\\.yml$/",
        "/^docs\\/qualification\\/application-update-production\\.complete\\.yml$/",
        "/^docs\\/qualification\\/application-update-production\\.controller-tools\\.yml$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+\\.\\d+)[\\r\\n]*$",
        "export[ \\t]+const[ \\t]+controllerNodeVersion[ \\t]*=[ \\t]*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\";",
        "(?:^|\\r?\\n)[ \\t]+node-version:[ \\t]*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?[ \\t]*(?:\\r?\\n|$)"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.config\\/tool-bootstrap\\.json$/"],
      "matchStrings": ["\\\"tauri_driver\\\":\\s*\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""],
      "depNameTemplate": "tauri-driver",
      "datasourceTemplate": "crate",
      "versioningTemplate": "cargo"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.aqua-version$/"],
      "matchStrings": ["(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "aquaproj/aqua",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^aqua\\.yaml$/"],
      "matchStrings": ["ref:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "aquaproj/aqua-registry",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^aqua\\.yaml$/"],
      "matchStrings": ["- name:\\s*(?<depName>[^@\\s]+)@(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.config\\/powershell-resources\\.psd1$/"],
      "matchStrings": [
        "(?<depName>PSScriptAnalyzer)[\\s\\S]*?version\\s*=\\s*'(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://www.powershellgallery.com/api/v2/",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/release\\.yml$/"],
      "matchStrings": ["syft-version:\\s*v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "anchore/syft",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tools/containers/build/Dockerfile$/"],
      "matchStrings": ["ARG POWERSHELL_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "PowerShell/PowerShell",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "timezone": "America/New_York",
  "prCreation": "immediate",
  "updateNotScheduled": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "groupName": null,
    "labels": ["dependencies", "security"]
  }
}
