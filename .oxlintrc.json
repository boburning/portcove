{
  "$schema": "./apps/desktop/node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "jsx-a11y/alt-text": "error",
    "no-undef": "error",
    "no-unused-vars": "error",
    "react/exhaustive-deps": "error",
    "react/globals": "off",
    "react/react-in-jsx-scope": "off",
    "react/refs": "off",
    "react/rules-of-hooks": "error",
    "react/set-state-in-effect": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "typescript/no-floating-promises": "error"
  },
  "options": {
    "reportUnusedDisableDirectives": "error",
    "typeAware": false,
    "typeCheck": false
  },
  "ignorePatterns": [
    "apps/desktop/dist/**",
    "apps/desktop/node_modules/**",
    "apps/desktop/src-tauri/gen/**",
    "target/**",
    "work/**"
  ],
  "overrides": [
    {
      "files": ["scripts/**/*.mjs", "apps/desktop/scripts/**/*.mjs", "apps/desktop/*.config.mjs"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["apps/desktop/scripts/desktop-*.mjs"],
      "env": {
        "browser": true,
        "node": true
      }
    },
    {
      "files": ["apps/desktop/src/**/*.{ts,tsx}"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["apps/desktop/src/**/*.test.{ts,tsx}", "apps/desktop/vite.config.ts"],
      "env": {
        "node": true
      },
      "rules": {
        "typescript/prefer-promise-reject-errors": "off",
        "typescript/require-await": "off",
        "typescript/unbound-method": "off"
      }
    }
  ]
}
