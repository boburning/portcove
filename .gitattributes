* text=auto eol=lf

*.icns binary
*.ico binary
*.blend binary
*.glb binary
*.jpg binary
*.png binary

# Unified diffs need a space context marker for blank upstream lines. Preserve
# dependency patch payloads; source paths keep normal whitespace checks.
patches/*.patch whitespace=-blank-at-eol

# These three dated evidence archives are preserved verbatim, including source
# Markdown hard breaks and final blank lines. No other documentation is exempt.
docs/archive/2026-09-03-prelaunch-feature-implementation-plan.md whitespace=-blank-at-eof
docs/archive/2026-09-04-supported-source-provenance-implementation-plan.md whitespace=-blank-at-eof
docs/archive/2026-09-04-ux-copy-content-interaction-audit.md whitespace=-trailing-space,-blank-at-eof

# Game-authored qualification inputs are hash-pinned verbatim on both platforms.
# Their final blank line belongs to the original game, not repository formatting.
scripts/fixtures/application-update-game-data/*.cfg -text whitespace=-blank-at-eof
scripts/fixtures/application-update-game-data/tyrian.sav binary
