+#[tokio::test]
+async fn accepted_definition_changes_refresh_only_affected_inputs_without_manual_ranking_edits() {
+    let mut f = fixture();
+    let first = f.service.compare_game_ports(&f.request, &f.preferences).await.unwrap();
+    assert_eq!(f.provider.calls.load(Ordering::SeqCst), 2);
+    let original_statuses = serde_json::to_value(f.service.statuses().unwrap()).unwrap();
+    f.provider.release.lock().unwrap().asset.sha256 = "b".repeat(64);
+    edit(&mut f, |document| {
+        document.ports[0].release.repository = "fixture/changed-upstream".into();
+    });
+    f.request.refresh = false;
+    f.request.evaluated_at = Some(110);
+    let changed = f.service.compare_game_ports(&f.request, &f.preferences).await.unwrap();
+    assert_eq!(f.provider.calls.load(Ordering::SeqCst), 3);
+    assert_eq!(changed.ports[0].offered_release.as_ref().unwrap().artifact_sha256, "b".repeat(64));
+    assert_eq!(changed.ports[0].freshness.state, ComparisonReleaseState::ProviderResolved);
+    assert_eq!(changed.ports[0].freshness.last_successful_resolution_at, Some(110));
+    assert_eq!(changed.ports[1].offered_release, first.ports[1].offered_release);
+    assert_eq!(changed.ports[1].freshness, first.ports[1].freshness);
+    assert_ne!(changed.input_id, first.input_id);
+    assert!(changed.assessment.as_ref().unwrap().candidates[0].evidence.iter().all(|record| {
+        record.disposition == crate::RecommendationEvidenceDisposition::HistoricalScope
+    }));
+    let repeated = f.service.compare_game_ports(&f.request, &f.preferences).await.unwrap();
+    assert_eq!(f.provider.calls.load(Ordering::SeqCst), 3);
+    assert_eq!(serde_json::to_value(repeated).unwrap(), serde_json::to_value(changed).unwrap());
+    assert_eq!(serde_json::to_value(f.service.statuses().unwrap()).unwrap(), original_statuses);
+}
+
+#[tokio::test]
+async fn failed_changed_definition_retains_last_good_binding_without_a_query_retry_loop() {
+    let mut f = fixture();
+    let first = f.service.compare_game_ports(&f.request, &f.preferences).await.unwrap();
+    f.provider.failure.store(true, Ordering::SeqCst);
+    edit(&mut f, |document| {
+        document.ports[0].release.repository = "fixture/changed-upstream".into();
+    });
+    f.request.refresh = false;
+    f.request.evaluated_at = Some(110);
+    let failed = f.service.compare_game_ports(&f.request, &f.preferences).await.unwrap();
+    assert_eq!(f.provider.calls.load(Ordering::SeqCst), 3);
+    assert_eq!(failed.ports[0].offered_release, first.ports[0].offered_release);
+    assert_eq!(failed.ports[0].freshness.state, ComparisonReleaseState::DefinitionChanged);
+    assert_eq!(failed.ports[0].freshness.last_successful_resolution_at, Some(100));
+    assert_eq!(failed.ports[0].freshness.last_attempt_at, Some(110));
+    assert!(!failed.assessment.as_ref().unwrap().candidates[0].recommendation_eligible);
+    f.request.evaluated_at = Some(120);
+    let repeated = f.service.compare_game_ports(&f.request, &f.preferences).await.unwrap();
+    assert_eq!(f.provider.calls.load(Ordering::SeqCst), 3);
+    assert_eq!(repeated.ports[0].freshness, failed.ports[0].freshness);
+    f.provider.failure.store(false, Ordering::SeqCst);
+    f.request.refresh = true;
+    let recovered = f.service.compare_game_ports(&f.request, &f.preferences).await.unwrap();
+    assert_eq!(recovered.ports[0].freshness.state, ComparisonReleaseState::ProviderResolved);
+    assert_eq!(recovered.ports[0].freshness.last_successful_resolution_at, Some(120));
+    assert_eq!(recovered.ports[0].freshness.offered_identity_changed_at, Some(100));
+}
+
+#[tokio::test]
+async fn accepted_quality_changes_recompute_without_refetching_unchanged_artifact_inputs() {
+    let mut f = fixture();
+    let first = f.service.compare_game_ports(&f.request, &f.preferences).await.unwrap();
+    let release = f.provider.release.lock().unwrap().clone();
+    edit(&mut f, |document| {
+        let metadata = observations("comparison-alpha", &release, false);
+        document.ports[0].presentation.as_mut().unwrap().recommendation =
+            Some(serde_json::to_value(metadata).unwrap());
+    });
+    f.request.refresh = false;
+    let comparable = f.service.compare_game_ports(&f.request, &f.preferences).await.unwrap();
+    assert_eq!(f.provider.calls.load(Ordering::SeqCst), 2);
+    assert_ne!(first.input_id, comparable.input_id);
+    assert_eq!(comparable.assessment.as_ref().unwrap().status, crate::PortRecommendationStatus::ComparableAlternatives);
+    assert!(comparable.assessment.unwrap().recommended.is_none());
+}
