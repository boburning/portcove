        {
          "regexp": "^\\s*(?:\\u001b\\[[0-9;]{0,32}m){0,8}×(?:\\u001b\\[[0-9;]{0,32}m){0,8} (?:\\u001b\\[[0-9;]{0,32}m){0,8}([a-z][a-z0-9-]{0,60}\\((?:TS[0-9]{4,5}|[a-z][a-z0-9-]{0,70})\\)):",
          "message": 1
