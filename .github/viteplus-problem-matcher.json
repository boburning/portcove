        {
          "regexp": "^\\s*╭─\\[(?:\\u001b\\[[0-9;]{0,32}m){0,8}(?:/home/runner/work/portcove/portcove/)?((?:(?:scripts|apps/desktop/(?:scripts|src))/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]{0,119}/){0,10}[A-Za-z0-9_-][A-Za-z0-9_.-]{0,119}\\.[cm]?[jt]sx?|vite\\.config\\.ts))(?:\\u001b\\[[0-9;]{0,32}m){0,8}:(\\d{1,6}):(\\d{1,4})\\]",
          "file": 1,
          "line": 2,
          "column": 3
        }
      ]
