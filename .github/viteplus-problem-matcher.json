{
  "problemMatcher": [
    {
      "owner": "portcove-viteplus-rule",
      "pattern": [
        {
          "regexp": "^((?:(?:scripts|apps/desktop/(?:scripts|src))/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]{0,119}/){0,10}[A-Za-z0-9_-][A-Za-z0-9_.-]{0,119}\\.[cm]?[jt]sx?|vite\\.config\\.ts)):(\\d{1,6}):(\\d{1,4}): (error|warning) ([a-z][a-z0-9-]{0,60}\\((?:TS[0-9]{4,5}|[a-z][a-z0-9-]{0,70})\\)):",
          "file": 1,
