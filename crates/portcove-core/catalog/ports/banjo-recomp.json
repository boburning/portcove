    "manual_setup": {
      "steps": [
        {
          "title": "Run the Linux ARM64 package",
          "instruction": "Unpack the Linux ARM64 tarball for BanjoRecompiled. Start BanjoRecompiled from the extracted folder. The current ARM64 build needs glibc 2.35 or newer, SDL2, GTK 3, libatomic and a Vulkan-capable driver."
        },
        {
          "title": "Install the Linux x64 Flatpak",
          "instruction": "Extract the Flatpak x64 ZIP to get io.github.banjorecomp.banjorecomp.flatpak. Install the file with Flatpak, then start io.github.banjorecomp.banjorecomp from the app menu or with flatpak run io.github.banjorecomp.banjorecomp."
        },
        {
          "title": "Select your original",
          "instruction": "In the upstream game picker choose your own USA 1.0 Banjo-Kazooie cartridge dump. The game validates the matching original before play."
        }
      ],
      "warnings": [
        "These packages use upstream or player-managed setup, replacement and data backups. Portcove has no native execution or populated-save result for these sibling packages."
      ],
      "help_url": "https://github.com/BanjoRecomp/BanjoRecomp#readme",
      "references": [
        {
          "title": "Keep the external profile",
          "instruction": "Preserve ~/.config/BanjoRecompiled on Linux, or your actual custom profile. For Flatpak also keep ~/.var/app/io.github.banjorecomp.banjorecomp. Back up the original, saves, mods and settings before replacing an upstream copy."
        }
      ]
    },
