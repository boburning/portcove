    "manual_setup": {
      "steps": [
        {
          "title": "Open Golden Balloon on Linux",
          "instruction": "Put the official x86-64 AppImage in a writable folder, mark it executable and open it. For the tarball, extract the whole archive and open AppRun inside Golden-Balloon.AppDir. Keep the folder together so the player can find its bundled libraries."
        },
        {
          "title": "Install the Apple Silicon app",
          "instruction": "Open the official ARM64 DMG and copy the app to Applications. If macOS blocks the unsigned app, follow the first-launch instructions in the upstream README."
        },
        {
          "title": "Choose your original game",
          "instruction": "Select your own Diddy Kong Racing US 1.1 or European 1.1 original. On Linux, browse inside the game, drag the file onto the launcher or paste its path. On Mac, use the file picker."
        }
      ],
      "warnings": [
        "Use the upstream package to install and update on Linux and Mac. Keep your saves, settings and add-ons backed up before replacing the package."
      ],
      "help_url": "https://github.com/akratch/goldenballoon#readme",
      "references": [
        {
          "title": "Find the data you need to back up",
          "instruction": "Keep the per-user profile or the active portable folder. On Linux, follow the upstream portable-data instructions for your package. Include saves, settings, ghosts and any custom content you want to keep."
        }
      ]
    }
