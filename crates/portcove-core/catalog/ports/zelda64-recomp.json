    "manual_setup": {
      "steps": [
        {
          "title": "Run the Linux ARM64 package",
          "instruction": "Extract the release ZIP, then unpack Zelda64Recompiled.tar.gz. Start Zelda64Recompiled from the extracted folder. The current ARM64 build needs glibc 2.34 or newer, SDL2, GTK 3, libatomic and a Vulkan-capable driver."
        },
        {
          "title": "Install the Linux x64 Flatpak",
          "instruction": "Extract the Flatpak x64 ZIP to get io.github.zelda64recomp.zelda64recomp.flatpak. Install the file with Flatpak, then start io.github.zelda64recomp.zelda64recomp from the app menu or with flatpak run io.github.zelda64recomp.zelda64recomp."
        },
        {
          "title": "Select your original",
          "instruction": "In the upstream game picker choose your own North American Majora’s Mask N64 cartridge dump. The game validates the matching original before play."
        }
      ],
      "warnings": [
        "These packages use upstream or player-managed setup, replacement and data backups. Portcove has no native execution or populated-save result for these sibling packages."
      ],
      "help_url": "https://github.com/Zelda64Recomp/Zelda64Recomp#readme",
      "references": [
        {
          "title": "Keep the external profile",
          "instruction": "Preserve ~/.config/Zelda64Recompiled on Linux, or your actual custom profile. For Flatpak also keep ~/.var/app/io.github.zelda64recomp.zelda64recomp. Back up the original, saves, mods and settings before replacing an upstream copy."
        }
      ]
    },
