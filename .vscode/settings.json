{
  "files.eol": "\n",
  "oxc.configPath": "vite.config.ts",
  "oxc.fmt.configPath": "vite.config.ts",
  "oxc.requireConfig": true,
  "oxc.typeAware": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "vitest.vitestCommandLine": "node scripts/run-viteplus.mts test",
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][html][markdown][yaml][toml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  }
}
