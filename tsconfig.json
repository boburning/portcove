{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "apps/desktop/vite.config.ts",
    "apps/desktop/i18next.config.ts",
    "apps/desktop/i18next.invalid.config.ts",
    "apps/desktop/stylelint.config.mjs",
    "scripts/frontend-tests.ts",
    "scripts/browser-traces.ts"
  ],
  "extends": "./tsconfig.base.json",
  "references": [
    { "path": "./scripts" },
    { "path": "./apps/desktop/scripts" },
    { "path": "./apps/desktop/test" },
    { "path": "./integrations/playnite" }
  ]
}
