index 25de099..24a40e8 100644
--- a/first_party/tig/src/file.c
+++ b/first_party/tig/src/file.c
@@ -15,6 +15,90 @@
 #include "tig/find_file.h"
 #include "tig/memory.h"
 
+
+#ifdef _WIN32
+#include <windows.h>
+#include "tig/prepared_copy.h"
+#include "tig/save_extract.h"
+#endif
+
+static bool tig_file_path_copy(char dst[TIG_MAX_PATH], const char* src)
+{
+#ifdef _WIN32
+    if (src == NULL) return false;
+    size_t length = 0;
+    while (length < TIG_MAX_PATH && src[length] != 0) length++;
+    if (length == 0 || length == TIG_MAX_PATH) return false;
+    memcpy(dst, src, length + 1);
+#else
+    strcpy(dst, src);
+#endif
+    return true;
+}
+
+static bool tig_file_path_format(char* output, size_t capacity, const char* format, ...)
+{
+    va_list arguments;
+    va_start(arguments, format);
+    int count = vsnprintf(output, capacity, format, arguments);
+    va_end(arguments);
+    if (count < 0 || (size_t)count >= capacity) { output[0] = 0; return false; }
+    return true;
+}
+
+static FILE* tig_file_plain_open(const char* path, const char* mode)
+{
+#ifdef _WIN32
+    return tig_prepared_copy_fopen(path, mode);
+#else
+    return fopen(path, mode);
+#endif
+}
+
+static bool tig_file_plain_mkdir(const char* path)
+{
+#ifdef _WIN32
+    char resolved[TIG_MAX_PATH];
+    if (!tig_prepared_copy_path(path, false, resolved)) return false;
+    DWORD attributes = GetFileAttributesA(resolved);
+    if (attributes != INVALID_FILE_ATTRIBUTES) {
+        return (attributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) == FILE_ATTRIBUTE_DIRECTORY;
+    }
+    return tig_prepared_copy_mkdir(path);
+#else
+    return SDL_CreateDirectory(path);
+#endif
+}
+
+static bool tig_file_plain_remove(const char* path)
+{
+#ifdef _WIN32
+    return tig_prepared_copy_remove(path);
+#else
+    return SDL_RemovePath(path);
+#endif
+}
+
+static bool tig_file_plain_rename(const char* source, const char* destination)
+{
+#ifdef _WIN32
+    return tig_prepared_copy_rename(source, destination);
+#else
+    return SDL_RenamePath(source, destination);
+#endif
+}
+
+static bool tig_file_plain_info(const char* path, SDL_PathInfo* info)
+{
+#ifdef _WIN32
+    char resolved[TIG_MAX_PATH];
+    if (!tig_prepared_copy_path(path, false, resolved)) return false;
+    return SDL_GetPathInfo(resolved, info);
+#else
+    return SDL_GetPathInfo(path, info);
+#endif
+}
+
