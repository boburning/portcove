@@ -6,6 +6,89 @@
 #include "tig/compat.h"
 #include "tig/memory.h"
 
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <stdlib.h>
+#include "tig/prepared_copy.h"
+
+typedef struct TigFindFileDataPriv {
+    HANDLE handle;
+    WIN32_FIND_DATAW entry;
+    char dir[TIG_MAX_PATH];
+    unsigned int visited;
+    bool first;
+} TigFindFileDataPriv;
+
+bool tig_find_first_file(const char* pattern, TigFindFileData* data)
+{
+    char resolved[TIG_MAX_PATH];
+    wchar_t wide[TIG_MAX_PATH];
+    memset(data, 0, sizeof(*data));
+    if (!tig_prepared_copy_path(pattern, true, resolved)) return false;
+    size_t length = strlen(resolved);
+    for (size_t i = 0; i <= length; i++) wide[i] = (unsigned char)resolved[i];
+    char* separator = strrchr(resolved, '\\');
+    if (separator == NULL || separator[1] == 0) return false;
+    *separator = 0;
+    TigFindFileDataPriv* priv = (TigFindFileDataPriv*)MALLOC(sizeof(*priv));
+    if (priv == NULL) abort();
+    memset(priv, 0, sizeof(*priv));
+    memcpy(priv->dir, resolved, strlen(resolved) + 1);
+    priv->handle = FindFirstFileW(wide, &priv->entry);
+    if (priv->handle == INVALID_HANDLE_VALUE) {
+        DWORD error = GetLastError();
+        FREE(priv);
+        if (error != ERROR_FILE_NOT_FOUND) abort();
+        return false;
+    }
+    priv->first = true;
+    data->handle = (intptr_t)priv;
+    if (tig_find_next_file(data)) return true;
+    tig_find_close(data);
+    return false;
+}
+
+bool tig_find_next_file(TigFindFileData* data)
+{
+    TigFindFileDataPriv* priv = (TigFindFileDataPriv*)data->handle;
+    if (priv == NULL) return false;
+    for (;;) {
+        if (!priv->first && !FindNextFileW(priv->handle, &priv->entry)) {
+            if (GetLastError() != ERROR_NO_MORE_FILES) abort();
+            return false;
+        }
+        priv->first = false;
+        if (++priv->visited > 65536) abort();
+        if (wcscmp(priv->entry.cFileName, L".") == 0 || wcscmp(priv->entry.cFileName, L"..") == 0) continue;
+        char name[TIG_MAX_PATH], path[TIG_MAX_PATH], physical[TIG_MAX_PATH];
+        size_t length = 0;
+        while (priv->entry.cFileName[length] != 0) {
+            wchar_t value = priv->entry.cFileName[length];
+            if (length >= 255 || value < 32 || value > 126) abort();
+            name[length++] = (char)value;
+        }
+        name[length] = 0;
+        int count = snprintf(path, sizeof(path), "%s\\%s", priv->dir, name);
+        if (count < 0 || count >= (int)sizeof(path)
+            || (priv->entry.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0
+            || !tig_prepared_copy_path(path, false, physical)
+            || !SDL_GetPathInfo(physical, &data->path_info)) abort();
+        memcpy(data->name, name, length + 1);
+        return true;
+    }
+}
+
+bool tig_find_close(TigFindFileData* data)
+{
+    TigFindFileDataPriv* priv = (TigFindFileDataPriv*)data->handle;
+    if (priv == NULL) return false;
+    bool closed = FindClose(priv->handle) != 0;
+    FREE(priv);
+    memset(data, 0, sizeof(*data));
+    return closed;
+}
