+#ifndef TIG_SAVE_EXTRACT_H_
+#define TIG_SAVE_EXTRACT_H_
+#ifdef _WIN32
+#include <stdbool.h>
+// Selected stock-module Current cache only. Both source streams are held,
+// bounded and parsed before creating a private sibling. Existing Current data
+// remains intact until complete extraction; a failed commit rolls back or
+// retains its exact backup without overwriting a competing destination.
+bool tig_save_archive_extract(const char* index_path, const char* data_path, const char* destination);
+#endif
+#endif
