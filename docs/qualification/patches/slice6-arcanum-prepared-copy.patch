new file mode 100644
index 0000000..c26ced1
--- /dev/null
+++ b/first_party/tig/include/tig/prepared_copy.h
@@ -0,0 +1,28 @@
+#ifndef TIG_PREPARED_COPY_H_
+#define TIG_PREPARED_COPY_H_
+
+#ifdef _WIN32
+#include <stdbool.h>
+#include <stdio.h>
+
+#define TIG_PREPARED_COPY_PATH_CAPACITY 260
+
+// Selected Windows source treatment only. The explicitly separate complete
+// prepared copy is the writable unit; no original installation is mounted.
+// Initialize before config/debug/TIG; no runtime opt-out or arbitrary argv.
+bool tig_prepared_copy_init(int argc);
+bool tig_prepared_copy_path(const char* path, bool pattern,
+    char output[TIG_PREPARED_COPY_PATH_CAPACITY]);
+FILE* tig_prepared_copy_fopen(const char* path, const char* mode);
+
+// Non-recursive, no-overwrite mutations of this copy only. Existing leaves
+// are held without following reparses; regular files must have one link.
+bool tig_prepared_copy_mkdir(const char* path);
+bool tig_prepared_copy_remove(const char* path);
+bool tig_prepared_copy_rename(const char* source, const char* destination);
+
+// Incremental UTF-16 enumeration, no reparse traversal; 32 levels/65536 objects.
+bool tig_prepared_copy_clear_directory(const char* path, bool remove_root);
+
+#endif /* _WIN32 */
+#endif /* TIG_PREPARED_COPY_H_ */
diff --git a/first_party/tig/include/tig/save_archive.h b/first_party/tig/include/tig/save_archive.h
new file mode 100644
index 0000000..38cc06c
--- /dev/null
+++ b/first_party/tig/include/tig/save_archive.h
@@ -0,0 +1,35 @@
+#ifndef TIG_SAVE_ARCHIVE_H_
+#define TIG_SAVE_ARCHIVE_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+// The selected stock-module route retains TIG's 260-byte path and signed
+// 32-bit archive data format, with finite index-record and directory budgets.
+#define TIG_SAVE_ARCHIVE_PATH_CAPACITY 260
+#define TIG_SAVE_ARCHIVE_MAX_COMPONENT 255
+#define TIG_SAVE_ARCHIVE_MAX_RECORDS 65536
+#define TIG_SAVE_ARCHIVE_MAX_DEPTH 32
+#define TIG_SAVE_ARCHIVE_MAX_INDEX_BYTES (TIG_SAVE_ARCHIVE_MAX_RECORDS * (TIG_SAVE_ARCHIVE_MAX_COMPONENT + 12))
+
+typedef struct TigSaveArchiveEntry {
+    char path[TIG_SAVE_ARCHIVE_PATH_CAPACITY];
+    size_t data_offset;
+    uint32_t size;
+    bool directory;
+} TigSaveArchiveEntry;
+
+typedef struct TigSaveArchivePlan {
+    size_t count;
+    TigSaveArchiveEntry* entries;
+} TigSaveArchivePlan;
+
+// Parse an already bounded raw index snapshot. No filesystem writes or data
+// payload allocation occurs here. root_length is the fully resolved physical
+// destination length, not a relative path's length. NULL means refusal.
+TigSaveArchivePlan* tig_save_archive_plan(const unsigned char* index, size_t index_size,
+    size_t data_size, size_t root_length);
+void tig_save_archive_plan_destroy(TigSaveArchivePlan* plan);
+
+#endif /* TIG_SAVE_ARCHIVE_H_ */
