+        if ((repo->type & TIG_FILE_REPOSITORY_DIRECTORY) != 0) {
+            int length = SDL_snprintf(joined, sizeof(joined), "%s\\%s", repo->path, logical);
+            return length >= 0 && length < (int)sizeof(joined)
+                && tig_prepared_copy_path(joined, false, output);
+        }
+    }
+    return false;
+}
+#endif
