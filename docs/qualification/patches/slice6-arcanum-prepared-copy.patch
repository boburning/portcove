diff --git a/first_party/tig/src/prepared_copy.c b/first_party/tig/src/prepared_copy.c
new file mode 100644
index 0000000..e795993
--- /dev/null
+++ b/first_party/tig/src/prepared_copy.c
@@ -0,0 +1,392 @@
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+#include "tig/prepared_copy.h"
+
+#include <fcntl.h>
+#include <io.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+
+static char copy_root[TIG_PREPARED_COPY_PATH_CAPACITY];
+static size_t copy_root_length;
+static HANDLE root_handle = INVALID_HANDLE_VALUE;
+
+static unsigned char lower_ascii(unsigned char ch)
+{
+    return ch >= 'A' && ch <= 'Z' ? (unsigned char)(ch + ('a' - 'A')) : ch;
+}
+
+static bool equal_prefix(const char* lhs, const char* rhs, size_t length)
+{
+    for (size_t i = 0; i < length; i++) {
+        if (lower_ascii((unsigned char)lhs[i]) != lower_ascii((unsigned char)rhs[i])) return false;
+    }
+    return true;
+}
+
+static bool ascii_path(const char* path, size_t* length)
+{
+    for (size_t i = 0; i < TIG_PREPARED_COPY_PATH_CAPACITY; i++) {
+        unsigned char ch = (unsigned char)path[i];
+        if (ch == 0) { *length = i; return i != 0; }
+        if (ch < 0x20 || ch > 0x7e) return false;
+    }
+    return false;
+}
+
+static bool plain_directory_chain(const char* path)
+{
+    char part[TIG_PREPARED_COPY_PATH_CAPACITY];
+    size_t length;
+    if (!ascii_path(path, &length) || length <= 3 || path[1] != ':' || path[2] != '\\') return false;
+    memcpy(part, path, length + 1);
+    for (size_t i = 3; i <= length; i++) {
+        if (part[i] != '\\' && part[i] != 0) continue;
+        char separator = part[i]; part[i] = 0;
+        DWORD attributes = GetFileAttributesA(part);
+        part[i] = separator;
+        if (attributes == INVALID_FILE_ATTRIBUTES
+            || (attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0
+            || (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0) return false;
+    }
+    return true;
+}
+
+static bool wide_ascii(const wchar_t* wide, char output[TIG_PREPARED_COPY_PATH_CAPACITY])
+{
+    // Never accept an ANSI best-fit spelling of a different Unicode directory.
+    for (size_t i = 0; i < TIG_PREPARED_COPY_PATH_CAPACITY; i++) {
+        if (wide[i] == 0) { output[i] = 0; return i != 0; }
+        if (wide[i] < 0x20 || wide[i] > 0x7e) return false;
+        output[i] = (char)wide[i];
+    }
+    return false;
+}
+
+static bool final_path(HANDLE handle, char output[TIG_PREPARED_COPY_PATH_CAPACITY])
+{
+    wchar_t buffer[TIG_PREPARED_COPY_PATH_CAPACITY + 4];
+    DWORD length = GetFinalPathNameByHandleW(handle, buffer, sizeof(buffer) / sizeof(buffer[0]), FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
+    if (length == 0 || length >= sizeof(buffer) / sizeof(buffer[0]) || length < 7
+        || memcmp(buffer, L"\\\\?\\", 4 * sizeof(buffer[0])) != 0) return false;
+    if (!wide_ascii(buffer + 4, output) || output[1] != ':' || output[2] != '\\') return false;
+    return true;
+}
+
+static bool loaded_path(const wchar_t* native, char output[TIG_PREPARED_COPY_PATH_CAPACITY])
+{
+    // Core may launch its canonical executable spelling. Strip only the exact
+    // extended local-drive prefix; UNC/device namespaces remain unsupported.
+    if (memcmp(native, L"\\\\?\\", 4 * sizeof(*native)) == 0) {
+        if (!((native[4] >= L'A' && native[4] <= L'Z') || (native[4] >= L'a' && native[4] <= L'z'))
+            || native[5] != L':' || native[6] != L'\\') return false;
+        native += 4;
+    }
+    return wide_ascii(native, output);
+}
+
+static void close_root(void)
+{
+    if (root_handle != INVALID_HANDLE_VALUE) CloseHandle(root_handle);
+    root_handle = INVALID_HANDLE_VALUE;
+    copy_root[0] = 0; copy_root_length = 0;
+}
+
+bool tig_prepared_copy_init(int argc)
+{
+    char cwd[TIG_PREPARED_COPY_PATH_CAPACITY], exe[TIG_PREPARED_COPY_PATH_CAPACITY];
+    char canonical[TIG_PREPARED_COPY_PATH_CAPACITY];
+    wchar_t native[TIG_PREPARED_COPY_PATH_CAPACITY + 4];
+    if (argc != 1 || root_handle != INVALID_HANDLE_VALUE) return false;
+    DWORD size = GetCurrentDirectoryW(sizeof(native) / sizeof(native[0]), native);
+    if (size == 0 || size >= sizeof(native) / sizeof(native[0]) || !loaded_path(native, cwd)
+        || !plain_directory_chain(cwd)) return false;
+    size = GetModuleFileNameW(NULL, native, sizeof(native) / sizeof(native[0]));
+    if (size == 0 || size >= sizeof(native) / sizeof(native[0]) || !loaded_path(native, exe)) return false;
+    char* separator = strrchr(exe, '\\');
+    if (separator == NULL) return false;
+    *separator = 0;
+    if (!plain_directory_chain(exe)) return false;
+    HANDLE working = CreateFileA(cwd, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE,
+        NULL, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    if (working == INVALID_HANDLE_VALUE) return false;
+    HANDLE executable_parent = CreateFileA(exe, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE,
+        NULL, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    bool valid = executable_parent != INVALID_HANDLE_VALUE && final_path(working, canonical)
+        && final_path(executable_parent, exe);
+    if (executable_parent != INVALID_HANDLE_VALUE) CloseHandle(executable_parent);
+    size_t length = valid ? strlen(canonical) : 0;
+    if (!valid || strlen(exe) != length || !equal_prefix(canonical, exe, length)
+        || !plain_directory_chain(canonical)) { CloseHandle(working); return false; }
+    memcpy(copy_root, canonical, length + 1); copy_root_length = length; root_handle = working;
+    if (atexit(close_root) != 0) { close_root(); return false; }
+    return true;
+}
+
+static bool component(const char* name, size_t length, bool wildcard)
+{
+    char stem[TIG_PREPARED_COPY_PATH_CAPACITY];
+    if (length == 0 || length > 255 || name[length - 1] == '.' || name[length - 1] == ' ') return false;
+    for (size_t i = 0; i < length; i++) {
+        unsigned char ch = (unsigned char)name[i];
+        if (ch < 0x20 || ch > 0x7e || strchr("\\/:\"<>|", ch) != NULL
+            || (!wildcard && (ch == '*' || ch == '?'))) return false;
+    }
+    size_t count = 0;
+    while (count < length && name[count] != '.') { stem[count] = (char)lower_ascii((unsigned char)name[count]); count++; }
+    while (count > 0 && stem[count - 1] == ' ') count--;
+    stem[count] = 0;
+    if (strcmp(stem, "con") == 0 || strcmp(stem, "prn") == 0 || strcmp(stem, "aux") == 0
+        || strcmp(stem, "nul") == 0 || strcmp(stem, "conin$") == 0 || strcmp(stem, "conout$") == 0
+        || strcmp(stem, "clock$") == 0) return false;
+    return !(count == 4 && (memcmp(stem, "com", 3) == 0 || memcmp(stem, "lpt", 3) == 0)
+        && stem[3] >= '1' && stem[3] <= '9');
+}
+
+bool tig_prepared_copy_path(const char* path, bool pattern, char output[TIG_PREPARED_COPY_PATH_CAPACITY])
+{
+    char normalized[TIG_PREPARED_COPY_PATH_CAPACITY];
+    size_t length;
+    if (path == NULL || output == NULL || root_handle == INVALID_HANDLE_VALUE || !ascii_path(path, &length)) return false;
+    memcpy(normalized, path, length + 1);
+    for (size_t i = 0; i < length; i++) if (normalized[i] == '/') normalized[i] = '\\';
+    const char* relative = normalized;
+    if (length >= 3 && normalized[1] == ':' && normalized[2] == '\\') {
+        if (length < copy_root_length || !equal_prefix(normalized, copy_root, copy_root_length)
+            || (length > copy_root_length && normalized[copy_root_length] != '\\')) return false;
+        relative = normalized + copy_root_length;
+        if (*relative == '\\') relative++;
+    } else if (normalized[0] == '\\' || strchr(normalized, ':') != NULL) return false;
+    if (relative[0] == '.' && relative[1] == '\\') relative += 2;
+    if (strcmp(relative, ".") == 0) relative++;
+    size_t relative_length = strlen(relative);
+    if (relative_length == 0) { memcpy(output, copy_root, copy_root_length + 1); return true; }
+    if (copy_root_length + 1 + relative_length >= TIG_PREPARED_COPY_PATH_CAPACITY) return false;
+    const char* start = relative;
+    for (const char* p = relative;; p++) {
+        if (*p != '\\' && *p != 0) continue;
+        if (!component(start, (size_t)(p - start), pattern && *p == 0)) return false;
+        if (*p == 0) break;
+        start = p + 1;
+    }
+    memcpy(output, copy_root, copy_root_length); output[copy_root_length] = '\\';
+    memcpy(output + copy_root_length + 1, relative, relative_length + 1);
+    // Existing ancestors must be ordinary directories. A missing final leaf is
+    // allowed for creation; parents are checked again by the mutating opener.
+    for (size_t i = copy_root_length + 1; i <= copy_root_length + 1 + relative_length; i++) {
+        if (output[i] != '\\' && output[i] != 0) continue;
+        char separator = output[i]; output[i] = 0;
+        bool last = separator == 0;
+        DWORD attributes = last && pattern ? INVALID_FILE_ATTRIBUTES : GetFileAttributesA(output);
+        DWORD error = attributes == INVALID_FILE_ATTRIBUTES ? GetLastError() : 0;
+        output[i] = separator;
+        if (last && pattern) return true;
+        if (attributes == INVALID_FILE_ATTRIBUTES) return last && (error == ERROR_FILE_NOT_FOUND || error == ERROR_PATH_NOT_FOUND);
+        if ((attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 || (!last && (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0)) return false;
+    }
+    return true;
+}
+
+FILE* tig_prepared_copy_fopen(const char* path, const char* mode)
+{
+    char resolved[TIG_PREPARED_COPY_PATH_CAPACITY], physical[TIG_PREPARED_COPY_PATH_CAPACITY];
+    bool update = false, binary = false, text = false, exclusive = false;
+    if (mode == NULL || (mode[0] != 'r' && mode[0] != 'w' && mode[0] != 'a')) return NULL;
+    size_t i;
+    for (i = 1; i < 5 && mode[i] != 0; i++) {
+        if (mode[i] == '+' && !update) update = true;
+        else if (mode[i] == 'b' && !binary && !text) binary = true;
+        else if (mode[i] == 't' && !binary && !text) text = true;
+        else if (mode[i] == 'x' && !exclusive && mode[0] == 'w') exclusive = true;
+        else return NULL;
+    }
+    if (i == 5 || !tig_prepared_copy_path(path, false, resolved)) return NULL;
+    if (!binary && !text) {
+        int translation;
+        if (_get_fmode(&translation) != 0 || (translation != _O_BINARY && translation != _O_TEXT)) return NULL;
+        binary = translation == _O_BINARY;
+    }
+    size_t length = strlen(resolved);
+    if (length <= copy_root_length) return NULL;
+    char parent[TIG_PREPARED_COPY_PATH_CAPACITY];
+    memcpy(parent, resolved, length + 1);
+    char* separator = strrchr(parent, '\\');
+    if (separator == NULL) return NULL;
+    *separator = 0;
+    if (!plain_directory_chain(parent)) return NULL;
+    bool writing = mode[0] != 'r' || update;
+    DWORD access = writing ? GENERIC_WRITE : GENERIC_READ;
+    if (update) access |= GENERIC_READ;
+    DWORD creation = exclusive ? CREATE_NEW : (mode[0] == 'r' ? OPEN_EXISTING : OPEN_ALWAYS);
+    HANDLE handle = CreateFileA(resolved, access, FILE_SHARE_READ, NULL, creation,
+        FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, NULL);
+    if (handle == INVALID_HANDLE_VALUE) return NULL;
+    BY_HANDLE_FILE_INFORMATION information;
+    bool valid = GetFileType(handle) == FILE_TYPE_DISK
+        && GetFileInformationByHandle(handle, &information)
+        && (information.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY)) == 0
+        && information.nNumberOfLinks == 1
+        && final_path(handle, physical)
+        && strlen(physical) > copy_root_length
+        && equal_prefix(physical, copy_root, copy_root_length)
+        && physical[copy_root_length] == '\\'
+        && plain_directory_chain(parent);
+    if (!valid) { CloseHandle(handle); return NULL; }
+    // No CREATE_ALWAYS/TRUNCATE_EXISTING: validate this exact held regular,
+    // single-link object before any truncation or transfer into CRT ownership.
+    int flags = update ? _O_RDWR : (writing ? _O_WRONLY : _O_RDONLY);
+    flags |= _O_NOINHERIT | (binary ? _O_BINARY : _O_TEXT);
+    if (mode[0] == 'a') flags |= _O_APPEND;
+    int descriptor = _open_osfhandle((intptr_t)handle, flags);
+    if (descriptor == -1) { CloseHandle(handle); return NULL; }
+    char stream_mode[4] = { mode[0], 0, 0, 0 };
+    size_t cursor = 1;
+    if (update) stream_mode[cursor++] = '+';
+    stream_mode[cursor++] = binary ? 'b' : 't';
+    stream_mode[cursor] = 0;
+    FILE* stream = _fdopen(descriptor, stream_mode);
+    if (stream == NULL) { _close(descriptor); return NULL; }
+    if (mode[0] == 'w') {
+        LARGE_INTEGER zero; zero.QuadPart = 0;
+        if (!SetFilePointerEx(handle, zero, NULL, FILE_BEGIN) || !SetEndOfFile(handle)) {
+            fclose(stream); return NULL;
+        }
+    }
+    // CRT _O_APPEND supplies append-on-every-write even after a caller seeks.
+    // fclose now owns both descriptor and the original verified OS handle.
+    return stream;
+}
+
+
+static HANDLE mutation_object(const char* path)
+{
+    char resolved[TIG_PREPARED_COPY_PATH_CAPACITY], physical[TIG_PREPARED_COPY_PATH_CAPACITY];
+    if (!tig_prepared_copy_path(path, false, resolved) || strlen(resolved) <= copy_root_length) return INVALID_HANDLE_VALUE;
+    HANDLE handle = CreateFileA(resolved, DELETE | FILE_READ_ATTRIBUTES,
+        FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+        FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    if (handle == INVALID_HANDLE_VALUE) return handle;
+    BY_HANDLE_FILE_INFORMATION information;
+    bool valid = GetFileType(handle) == FILE_TYPE_DISK
+        && GetFileInformationByHandle(handle, &information)
+        && (information.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) == 0
+        && ((information.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 || information.nNumberOfLinks == 1)
+        && final_path(handle, physical)
+        && strlen(physical) == strlen(resolved)
+        && equal_prefix(physical, resolved, strlen(resolved));
+    if (!valid) { CloseHandle(handle); return INVALID_HANDLE_VALUE; }
+    return handle;
+}
+
+bool tig_prepared_copy_mkdir(const char* path)
+{
+    char resolved[TIG_PREPARED_COPY_PATH_CAPACITY];
+    if (!tig_prepared_copy_path(path, false, resolved) || strlen(resolved) <= copy_root_length) return false;
+    // CreateDirectory never traverses a missing final component or overwrites an
+    // existing object. The path guard checked every existing parent directory.
+    return CreateDirectoryA(resolved, NULL) != 0;
+}
+
+bool tig_prepared_copy_remove(const char* path)
+{
+    HANDLE handle = mutation_object(path);
+    if (handle == INVALID_HANDLE_VALUE) return false;
+    FILE_DISPOSITION_INFO disposition; disposition.DeleteFile = TRUE;
+    bool result = SetFileInformationByHandle(handle, FileDispositionInfo, &disposition, sizeof(disposition)) != 0;
+    CloseHandle(handle);
+    return result;
+}
+
+bool tig_prepared_copy_rename(const char* source, const char* destination)
+{
+    char resolved[TIG_PREPARED_COPY_PATH_CAPACITY];
+    if (!tig_prepared_copy_path(destination, false, resolved) || strlen(resolved) <= copy_root_length) return false;
+    // Rename is deliberately no-overwrite: both an existing ordinary target
+    // and a target that appears after validation are preserved by the kernel.
+    if (GetFileAttributesA(resolved) != INVALID_FILE_ATTRIBUTES || GetLastError() != ERROR_FILE_NOT_FOUND) return false;
+    HANDLE handle = mutation_object(source);
+    if (handle == INVALID_HANDLE_VALUE) return false;
+    union {
+        FILE_RENAME_INFO alignment;
+        unsigned char bytes[sizeof(FILE_RENAME_INFO) + TIG_PREPARED_COPY_PATH_CAPACITY * sizeof(WCHAR)];
+    } storage;
+    memset(&storage, 0, sizeof(storage));
+    FILE_RENAME_INFO* rename = (FILE_RENAME_INFO*)storage.bytes;
+    size_t length = strlen(resolved);
+    rename->ReplaceIfExists = FALSE;
+    rename->RootDirectory = NULL;
+    rename->FileNameLength = (DWORD)(length * sizeof(WCHAR));
+    for (size_t i = 0; i <= length; i++) rename->FileName[i] = (WCHAR)(unsigned char)resolved[i];
+    bool result = SetFileInformationByHandle(handle, FileRenameInfo, rename,
+        (DWORD)(offsetof(FILE_RENAME_INFO, FileName) + (length + 1) * sizeof(WCHAR))) != 0;
+    CloseHandle(handle);
+    return result;
+}
+
+
+static bool clear_directory_worker(const char* path, bool remove_root, size_t* budget, unsigned int depth)
+{
+    if (depth > 32 || *budget == 0) return false;
+    (*budget)--;
+    char resolved[TIG_PREPARED_COPY_PATH_CAPACITY];
+    if (!tig_prepared_copy_path(path, false, resolved)) return false;
+    HANDLE directory = mutation_object(resolved);
+    if (directory == INVALID_HANDLE_VALUE) return false;
+    BY_HANDLE_FILE_INFORMATION information;
+    if (!GetFileInformationByHandle(directory, &information)
+        || (information.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) == 0) {
+        CloseHandle(directory); return false;
+    }
+    size_t length = strlen(resolved);
+    if (length + 2 >= TIG_PREPARED_COPY_PATH_CAPACITY) { CloseHandle(directory); return false; }
+    WCHAR pattern[TIG_PREPARED_COPY_PATH_CAPACITY];
+    for (size_t i = 0; i < length; i++) pattern[i] = (WCHAR)(unsigned char)resolved[i];
+    pattern[length] = L'\\'; pattern[length + 1] = L'*'; pattern[length + 2] = 0;
+    WIN32_FIND_DATAW entry;
+    HANDLE find = FindFirstFileW(pattern, &entry);
+    bool success = true;
+    if (find == INVALID_HANDLE_VALUE) {
+        success = GetLastError() == ERROR_FILE_NOT_FOUND;
+    } else {
+        for (;;) {
+            bool trivia = entry.cFileName[0] == L'.'
+                && (entry.cFileName[1] == 0 || (entry.cFileName[1] == L'.' && entry.cFileName[2] == 0));
+            if (!trivia) {
+                char name[TIG_PREPARED_COPY_PATH_CAPACITY], child[TIG_PREPARED_COPY_PATH_CAPACITY];
+                if (*budget == 0 || (entry.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0
+                    || !wide_ascii(entry.cFileName, name)) { success = false; break; }
+                int count = snprintf(child, sizeof(child), "%s\\%s", resolved, name);
+                if (count < 0 || (size_t)count >= sizeof(child)) { success = false; break; }
+                if ((entry.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0) {
+                    if (!clear_directory_worker(child, true, budget, depth + 1)) { success = false; break; }
+                } else {
+                    (*budget)--;
+                    if (!tig_prepared_copy_remove(child)) { success = false; break; }
+                }
+            }
+            if (!FindNextFileW(find, &entry)) {
+                if (GetLastError() != ERROR_NO_MORE_FILES) success = false;
+                break;
+            }
+        }
+        if (!FindClose(find)) success = false;
+    }
+    if (success && remove_root) {
+        FILE_DISPOSITION_INFO disposition; disposition.DeleteFile = TRUE;
+        success = SetFileInformationByHandle(directory, FileDispositionInfo, &disposition, sizeof(disposition)) != 0;
+    }
+    CloseHandle(directory);
+    return success;
+}
+
+bool tig_prepared_copy_clear_directory(const char* path, bool remove_root)
+{
+    size_t budget = 65536;
+    return clear_directory_worker(path, remove_root, &budget, 0);
+}
+
+#endif /* _WIN32 */
diff --git a/first_party/tig/src/save_archive.c b/first_party/tig/src/save_archive.c
new file mode 100644
index 0000000..01e8aa3
--- /dev/null
+++ b/first_party/tig/src/save_archive.c
@@ -0,0 +1,201 @@
+#include "tig/save_archive.h"
+
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+static unsigned char ascii_lower(unsigned char ch)
+{
+    return ch >= 'A' && ch <= 'Z' ? (unsigned char)(ch + ('a' - 'A')) : ch;
+}
+
+static bool component_valid(const unsigned char* name, size_t length)
+{
+    size_t stem = 0;
+    char base[TIG_SAVE_ARCHIVE_MAX_COMPONENT + 1];
+    if (length == 0 || length > TIG_SAVE_ARCHIVE_MAX_COMPONENT
+        || name[length - 1] == '.' || name[length - 1] == ' ') {
+        return false;
+    }
+    for (size_t i = 0; i < length; i++) {
+        unsigned char ch = name[i];
+        if (ch < 0x20 || ch > 0x7e || strchr("\\/:*?\"<>|", ch) != NULL) {
+            return false;
+        }
+    }
+    while (stem < length && name[stem] != '.') {
+        base[stem] = (char)ascii_lower(name[stem]);
+        stem++;
+    }
+    // Win32 also recognizes reserved device stems with spaces before a dot.
+    // This comparison does not turn the supplied name into an accepted alias.
+    while (stem > 0 && base[stem - 1] == ' ') {
+        stem--;
+    }
+    base[stem] = '\0';
+    if (strcmp(base, "con") == 0 || strcmp(base, "prn") == 0
+        || strcmp(base, "aux") == 0 || strcmp(base, "nul") == 0
+        || strcmp(base, "conin$") == 0 || strcmp(base, "conout$") == 0
+        || strcmp(base, "clock$") == 0) {
+        return false;
+    }
+    return !(stem == 4 && (memcmp(base, "com", 3) == 0 || memcmp(base, "lpt", 3) == 0)
+        && base[3] >= '1' && base[3] <= '9');
+}
+
+static bool read_i32(const unsigned char* index, size_t length, size_t* cursor, int32_t* value)
+{
+    if (*cursor > length || length - *cursor < sizeof(*value)) {
+        return false;
+    }
+    // TIG's selected Windows archive is little endian, independent of the
+    // validation host. Reject negative lengths before any copy or indexing.
+    uint32_t raw = (uint32_t)index[*cursor]
+        | ((uint32_t)index[*cursor + 1] << 8)
+        | ((uint32_t)index[*cursor + 2] << 16)
+        | ((uint32_t)index[*cursor + 3] << 24);
+    memcpy(value, &raw, sizeof(raw));
+    *cursor += sizeof(*value);
+    return true;
+}
+
+static int entry_compare(const void* lhs, const void* rhs)
+{
+    const TigSaveArchiveEntry* const* left = lhs;
+    const TigSaveArchiveEntry* const* right = rhs;
+    const unsigned char* a = (const unsigned char*)(*left)->path;
+    const unsigned char* b = (const unsigned char*)(*right)->path;
+    for (;;) {
+        unsigned char lower_a = ascii_lower(*a);
+        unsigned char lower_b = ascii_lower(*b);
+        if (lower_a != lower_b || lower_a == 0) {
+            return (int)lower_a - (int)lower_b;
+        }
+        a++;
+        b++;
+    }
+}
+
+TigSaveArchivePlan* tig_save_archive_plan(const unsigned char* index, size_t index_size,
+    size_t data_size, size_t root_length)
+{
+    TigSaveArchivePlan* plan = NULL;
+    TigSaveArchiveEntry** sorted = NULL;
+    char prefix[TIG_SAVE_ARCHIVE_PATH_CAPACITY] = { 0 };
+    size_t parents[TIG_SAVE_ARCHIVE_MAX_DEPTH];
+    size_t depth = 0;
+    size_t prefix_length = 0;
+    size_t cursor = 0;
+    size_t data_cursor = 0;
+    size_t records = 0;
+    bool finished = false;
+
+    if (index == NULL || index_size < 4 || index_size > TIG_SAVE_ARCHIVE_MAX_INDEX_BYTES
+        || data_size > INT32_MAX || root_length == 0 || root_length >= TIG_SAVE_ARCHIVE_PATH_CAPACITY) {
+        return NULL;
+    }
+    // Allocation follows actual bounded raw bytes, never a declared name/data
+    // length. Even a compact INT32_MAX-name fixture only gets a tiny table.
+    size_t capacity = index_size / 4;
+    if (capacity > TIG_SAVE_ARCHIVE_MAX_RECORDS) {
+        capacity = TIG_SAVE_ARCHIVE_MAX_RECORDS;
+    }
+    plan = calloc(1, sizeof(*plan));
+    if (plan == NULL) {
+        return NULL;
+    }
+    plan->entries = calloc(capacity, sizeof(*plan->entries));
+    if (plan->entries == NULL) {
+        goto refused;
+    }
+
+    while (cursor < index_size) {
+        int32_t type;
+        int32_t length;
+        int32_t size;
+        if (++records > TIG_SAVE_ARCHIVE_MAX_RECORDS || !read_i32(index, index_size, &cursor, &type)) {
+            goto refused;
+        }
+        if (type == 3) {
+            finished = depth == 0 && cursor == index_size && data_cursor == data_size;
+            break;
+        }
+        if (type == 2) {
+            if (depth == 0) {
+                goto refused;
+            }
+            prefix_length = parents[--depth];
+            prefix[prefix_length] = '\0';
+            continue;
+        }
+        if ((type != 0 && type != 1) || plan->count >= capacity
+            || !read_i32(index, index_size, &cursor, &length)
+            || length <= 0 || length > TIG_SAVE_ARCHIVE_MAX_COMPONENT
+            || (size_t)length > index_size - cursor
+            || !component_valid(index + cursor, (size_t)length)) {
+            goto refused;
+        }
+        size_t relative_length = prefix_length + (size_t)length;
+        if (relative_length >= TIG_SAVE_ARCHIVE_PATH_CAPACITY
+            || root_length + 1 + relative_length >= TIG_SAVE_ARCHIVE_PATH_CAPACITY) {
+            goto refused;
+        }
+        TigSaveArchiveEntry* entry = &plan->entries[plan->count++];
+        memcpy(entry->path, prefix, prefix_length);
+        memcpy(entry->path + prefix_length, index + cursor, (size_t)length);
+        entry->path[relative_length] = '\0';
+        cursor += (size_t)length;
+        entry->directory = type == 1;
+        if (entry->directory) {
+            if (depth == TIG_SAVE_ARCHIVE_MAX_DEPTH || relative_length + 1 >= sizeof(prefix)) {
+                goto refused;
+            }
+            parents[depth++] = prefix_length;
+            memcpy(prefix, entry->path, relative_length);
+            prefix[relative_length] = '/';
+            prefix_length = relative_length + 1;
+            prefix[prefix_length] = '\0';
+        } else {
+            if (!read_i32(index, index_size, &cursor, &size) || size < 0
+                || (size_t)size > data_size - data_cursor) {
+                goto refused;
+            }
+            entry->data_offset = data_cursor;
+            entry->size = (uint32_t)size;
+            data_cursor += (size_t)size;
+        }
+    }
+    if (!finished) {
+        goto refused;
+    }
+    if (plan->count > 1) {
+        sorted = malloc(plan->count * sizeof(*sorted));
+        if (sorted == NULL) {
+            goto refused;
+        }
+        for (size_t i = 0; i < plan->count; i++) {
+            sorted[i] = &plan->entries[i];
+        }
+        qsort(sorted, plan->count, sizeof(*sorted), entry_compare);
+        for (size_t i = 1; i < plan->count; i++) {
+            if (entry_compare(&sorted[i - 1], &sorted[i]) == 0) {
+                goto refused;
+            }
+        }
+        free(sorted);
+    }
+    return plan;
+
+refused:
+    free(sorted);
+    tig_save_archive_plan_destroy(plan);
+    return NULL;
+}
+
+void tig_save_archive_plan_destroy(TigSaveArchivePlan* plan)
+{
+    if (plan != NULL) {
+        free(plan->entries);
+        free(plan);
+    }
+}
diff --git a/first_party/tig/src/save_extract.c b/first_party/tig/src/save_extract.c
new file mode 100644
index 0000000..55bfa45
--- /dev/null
+++ b/first_party/tig/src/save_extract.c
@@ -0,0 +1,149 @@
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <io.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "tig/prepared_copy.h"
+#include "tig/save_archive.h"
+#include "tig/save_extract.h"
+
+static bool missing(const char* path)
+{
+    DWORD attributes = GetFileAttributesA(path);
+    return attributes == INVALID_FILE_ATTRIBUTES && GetLastError() == ERROR_FILE_NOT_FOUND;
+}
+
+bool tig_save_archive_extract(const char* index_path, const char* data_path, const char* destination)
+{
+    FILE* index = NULL;
+    FILE* data = NULL;
+    unsigned char* raw = NULL;
+    TigSaveArchivePlan* plan = NULL;
+    char current[260], copy_root[260], parent[260], stage[260] = { 0 }, backup[260] = { 0 };
+    bool stage_created = false, previous_moved = false, success = false;
+    if (!tig_prepared_copy_path(destination, false, current)
+        || !tig_prepared_copy_path(".", false, copy_root)
+        || strlen(current) <= strlen(copy_root)) goto finished;
+    memcpy(parent, current, strlen(current) + 1);
+    char* separator = strrchr(parent, '\\');
+    if (separator == NULL || _stricmp(separator + 1, "Current") != 0) goto finished;
+    *separator = 0;
+    separator = strrchr(parent, '\\');
+    if (separator == NULL || _stricmp(separator + 1, "Save") != 0) goto finished;
+    DWORD old_attributes = GetFileAttributesA(current);
+    bool old_exists = old_attributes != INVALID_FILE_ATTRIBUTES;
+    if (old_exists && (old_attributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) != FILE_ATTRIBUTE_DIRECTORY) goto finished;
+    if (!old_exists && GetLastError() != ERROR_FILE_NOT_FOUND) goto finished;
+
+    // Stock slot pairs are direct children of this same Save directory.
+    // Never consume sources from Current: its prior cache may be cleaned after
+    // a successful commit, and canonical slot bytes must remain untouched.
+    char resolved_index[260], resolved_data[260];
+    if (!tig_prepared_copy_path(index_path, false, resolved_index)
+        || !tig_prepared_copy_path(data_path, false, resolved_data)) goto finished;
+    size_t parent_length = strlen(parent), index_length = strlen(resolved_index), data_length = strlen(resolved_data);
+    if (index_length <= parent_length + 6 || data_length != index_length
+        || _strnicmp(resolved_index, parent, parent_length) != 0
+        || _strnicmp(resolved_data, parent, parent_length) != 0
+        || resolved_index[parent_length] != '\\' || resolved_data[parent_length] != '\\'
+        || strchr(resolved_index + parent_length + 1, '\\') != NULL
+        || strchr(resolved_data + parent_length + 1, '\\') != NULL
+        || _stricmp(resolved_index + index_length - 5, ".tfai") != 0
+        || _stricmp(resolved_data + data_length - 5, ".tfaf") != 0
+        || _strnicmp(resolved_index, resolved_data, index_length - 5) != 0) goto finished;
+    index = tig_prepared_copy_fopen(resolved_index, "rb");
+    data = tig_prepared_copy_fopen(resolved_data, "rb");
+    if (index == NULL || data == NULL) goto finished;
+    // Bound the physical held streams before allocation, copying or parser use.
+    __int64 index_size = _filelengthi64(_fileno(index));
+    __int64 data_size = _filelengthi64(_fileno(data));
+    if (index_size <= 0 || index_size > TIG_SAVE_ARCHIVE_MAX_INDEX_BYTES
+        || data_size < 0 || data_size > INT32_MAX) goto finished;
+    raw = malloc((size_t)index_size);
+    if (raw == NULL || fread(raw, 1, (size_t)index_size, index) != (size_t)index_size
+        || fgetc(index) != EOF || ferror(index)) goto finished;
+
+    bool names_available = false;
+    for (unsigned int attempt = 0; attempt < 128; attempt++) {
+        DWORD process = GetCurrentProcessId();
+        unsigned long long tick = (unsigned long long)GetTickCount64();
+        int stage_length = snprintf(stage, sizeof(stage), "%s\\pc6-stage-%08lx-%016llx-%02x", parent, (unsigned long)process, tick, attempt);
+        int backup_length = snprintf(backup, sizeof(backup), "%s\\pc6-backup-%08lx-%016llx-%02x", parent, (unsigned long)process, tick, attempt);
+        if (stage_length < 0 || backup_length < 0 || (size_t)stage_length >= sizeof(stage) || (size_t)backup_length >= sizeof(backup)) goto finished;
+        char checked[260];
+        if (!tig_prepared_copy_path(stage, false, checked) || !tig_prepared_copy_path(backup, false, checked)) goto finished;
+        if (missing(stage) && missing(backup)) { names_available = true; break; }
+    }
+    if (!names_available) goto finished;
+    size_t physical_length = strlen(stage) > strlen(current) ? strlen(stage) : strlen(current);
+    plan = tig_save_archive_plan(raw, (size_t)index_size, (size_t)data_size, physical_length);
+    free(raw); raw = NULL;
+    if (plan == NULL) goto finished;
+    bool has_game_data = false;
+    for (size_t entry = 0; entry < plan->count; entry++) {
+        if (!plan->entries[entry].directory && plan->entries[entry].size > 0
+            && _stricmp(plan->entries[entry].path, "data.sav") == 0) has_game_data = true;
+    }
+    if (!has_game_data) goto finished;
+    // No destination or staging mutation has occurred before full validation.
+    if (!tig_prepared_copy_mkdir(stage)) goto finished;
+    stage_created = true;
+    for (size_t entry = 0; entry < plan->count; entry++) {
+        const TigSaveArchiveEntry* item = &plan->entries[entry];
+        char path[260];
+        int count = snprintf(path, sizeof(path), "%s\\%s", stage, item->path);
+        if (count < 0 || (size_t)count >= sizeof(path)) goto finished;
+        if (item->directory) {
+            if (!tig_prepared_copy_mkdir(path)) goto finished;
+        } else {
+            if (_ftelli64(data) != (__int64)item->data_offset) goto finished;
+            FILE* output = tig_prepared_copy_fopen(path, "wbx");
+            if (output == NULL) goto finished;
+            unsigned char buffer[32768];
+            size_t remaining = item->size;
+            bool copied = true;
+            while (remaining > 0) {
+                size_t amount = remaining < sizeof(buffer) ? remaining : sizeof(buffer);
+                if (fread(buffer, 1, amount, data) != amount || fwrite(buffer, 1, amount, output) != amount) { copied = false; break; }
+                remaining -= amount;
+            }
+            if (fflush(output) != 0 || _commit(_fileno(output)) != 0) copied = false;
+            if (fclose(output) != 0) copied = false;
+            if (!copied) goto finished;
+        }
+    }
+    if (_ftelli64(data) != data_size || fgetc(data) != EOF || ferror(data)
+        || _filelengthi64(_fileno(index)) != index_size || _filelengthi64(_fileno(data)) != data_size) goto finished;
+    int data_closed = fclose(data); data = NULL;
+    int index_closed = fclose(index); index = NULL;
+    if (data_closed != 0 || index_closed != 0) goto finished;
+    // Best-effort custody diagnostics, not a journal or automatic recovery.
+    fprintf(stderr, "Prepared save cache commit: Current=%s staging=%s prior=%s\n", current, stage, backup);
+    fflush(stderr);
+    if (old_exists) {
+        if (!tig_prepared_copy_rename(current, backup)) goto finished;
+        previous_moved = true;
+    }
+    if (!tig_prepared_copy_rename(stage, current)) {
+        if (previous_moved && tig_prepared_copy_rename(backup, current)) previous_moved = false;
+        goto finished;
+    }
+    stage_created = false;
+    success = true;
+    // Current is complete. Cleanup never follows redirects or weakens file-link
+    // checks; a refusal retains the prior cache as a separate recovery copy.
+    if (previous_moved && tig_prepared_copy_clear_directory(backup, true)) previous_moved = false;
+finished:
+    if (index != NULL) fclose(index);
+    if (data != NULL) fclose(data);
+    free(raw);
+    tig_save_archive_plan_destroy(plan);
+    if (stage_created) fprintf(stderr, "Prepared save extraction retained staging: %s\n", stage);
+    if (previous_moved) fprintf(stderr, "Prepared save extraction retained prior cache: %s\n", backup);
+    return success;
+}
