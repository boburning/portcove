{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "scripts/ci-job-timeout-probe.mts",
    "scripts/*.test.{js,mjs,ts,mts}",
    "integrations/playnite/*.test.{mjs,mts}",
    "scripts/container-entry.{mjs,mts}",
    "scripts/container-build-entry.{mjs,mts}",
    "scripts/rust-test-tree-supervisor.{mjs,mts}",
    "scripts/rust-coverage.mts",
    "scripts/qualification-nextest.mts",
    "scripts/nextest-outcomes-cli.mts",
    "scripts/qualification-rustdoc.mts",
    "scripts/viteplus-renovate-probe.{mjs,mts}",
    "scripts/generate-catalog.{mjs,mts}",
    "scripts/prepare-port.mts",
    "scripts/migrate-catalog-schema2.{mjs,mts}",
    "apps/desktop/i18next.invalid.config.{ts,mts}",
    "apps/desktop/src/i18next-contract.test-d.ts",
    "apps/desktop/src/i18next.d.ts",
    "apps/desktop/src/dev-scenarios/entry.{ts,tsx}",
    "apps/desktop/test/browser-setup.{mjs,mts}",
    "apps/desktop/public/theme-bootstrap.{js,ts}",
    "apps/desktop/scripts/*.native.test.{mjs,mts}",
    "apps/desktop/scripts/browser-package-compatibility.{mjs,mts}",
    "apps/desktop/scripts/copy-lint-plugin.{mjs,mts}",
    "scripts/aqua-integrity.{mjs,mts}",
    "scripts/audit.{mjs,mts}",
    "scripts/ci-health.{mjs,mts}",
    "scripts/container-browser.{mjs,mts}",
    "scripts/container-build.{mjs,mts}",
    "scripts/desktop-test-cli.{mjs,mts}",
    "scripts/desktop-verify.{mjs,mts}",
    "scripts/dev-doctor.{mjs,mts}",
    "scripts/handoff-evidence.{mjs,mts}",
    "scripts/local-validation.{mjs,mts}",
    "scripts/pr-delivery.{mjs,mts}",
    "scripts/precommit.mts",
    "scripts/resource-status.{mjs,mts}",
    "scripts/test-duration-reporter.{mjs,mts}",
    "scripts/required-node-test-reporter.{mjs,mts}",
    "scripts/coverage-node-reporter.mts",
    "scripts/coverage-node-loader.mts",
    "scripts/upstream-observer.{mjs,mts}",
    "scripts/viteplus-cli.{mjs,mts}",
    "scripts/daily-discovery.mts",
    "scripts/qualify-semantic-isolation.mts",
    "scripts/release-reviewed-inputs.mts"
  ],
  "ignoreUnresolvedImports": [
    "/theme-bootstrap.js",
    "../.github/workflows/release-reviewed-inputs.yml"
  ],
  "ignorePatterns": [
    "target/**",
    "work/**",
    "outputs/**",
    "release-assets/**",
    ".codex-remote-attachments/**",
    "apps/desktop/dist/**",
    "apps/desktop/src-tauri/gen/**",
    "**/*.generated.*",
    "crates/**/tests/fixtures/**"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "shared",
        "patterns": ["apps/desktop/src/shared/**"]
      },
      {
        "name": "features",
        "patterns": ["apps/desktop/src/features/**"]
      }
    ],
    "rules": [
      {
        "from": "shared",
        "allow": ["shared"],
        "allowTypeOnly": []
      }
    ]
  },
  "framework": [
    {
      "name": "portcove-tooling-consumers",
      "detection": {
        "type": "fileExists",
        "pattern": "vite.config.ts"
      },
      "entryPoints": ["vite.config.ts"],
      "entryPointRole": "support",
      "usedExports": [
        {
          "pattern": "vite.config.ts",
          "exports": ["default"]
        },
        {
          "pattern": "scripts/maintainer-config.mts",
          "exports": ["maintainerConfigPath"]
        }
      ],
      "toolingDependencies": ["vite-plus", "yaml"]
    },
    {
      "name": "portcove-desktop-unit-tests",
      "detection": {
        "type": "fileExists",
        "pattern": "apps/desktop/scripts/**/*.test.{ts,mts}"
      },
      "entryPoints": ["apps/desktop/scripts/**/*.test.{ts,mts}"],
      "entryPointRole": "test"
    }
  ]
}
